-- ---------- BANGUN MENU ----------
local function buildMain(mods, errs)
	local TABS = {
		{ key = "Fishing", name = "Fishing", title = "Auto Fishing", tag = "FS", desc = "Lempar, tunggu, auto menang minigame" },
		{ key = "Tani", name = "Tani", title = "Auto Tani", tag = "TN", desc = "Cangkul, tanam, siram & panen" },
		{ key = "Ternak", name = "Ternak", title = "Auto Ternak", tag = "TK", desc = "Ngarit, lumbung & isi pakan" },
		{ key = "Dulang", name = "Dulang", title = "Auto Dulang", tag = "DL", desc = "Dulang emas & lebur batangan" },
	}

	local cam = workspace.CurrentCamera
	local win = new("Frame", {
		Name = "Window", Size = UDim2.fromOffset(350, 520), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = C.bg, BackgroundTransparency = 0.04, BorderSizePixel = 0,
	}, gui)
	round(win, 26)
	new("UIStroke", { Color = Color3.fromRGB(80, 80, 84), Thickness = 1, Transparency = 0.3 }, win)
	local scale = new("UIScale", { Scale = math.clamp(cam.ViewportSize.Y / 640, 0.6, 1) }, win)

	-- header
	local head = new("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1 }, win)
	new("TextLabel", {
		Size = UDim2.new(1, -110, 0, 26), Position = UDim2.fromOffset(18, 10), BackgroundTransparency = 1,
		Text = "Majapahit RP", Font = Enum.Font.GothamBlack, TextSize = 20, TextColor3 = C.tx,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, head)
	new("TextLabel", {
		Size = UDim2.new(1, -110, 0, 16), Position = UDim2.fromOffset(18, 34), BackgroundTransparency = 1,
		Text = "Menu Auto · v1", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.tx2,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, head)

	local bubble = new("TextButton", {
		Size = UDim2.fromOffset(46, 46), Position = UDim2.new(0, 16, 0.5, -23), BackgroundColor3 = C.gold,
		Text = "M", Font = Enum.Font.GothamBlack, TextSize = 20, TextColor3 = Color3.fromRGB(40, 28, 8),
		Visible = false, AutoButtonColor = true,
	}, gui)
	round(bubble, 23)

	local function dot(x, color, txt, cb)
		local b = new("TextButton", {
			Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, x, 0, 18), BackgroundColor3 = color,
			Text = txt, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Color3.fromRGB(60, 40, 0),
			AutoButtonColor = true,
		}, head)
		round(b, 12)
		on(b.MouseButton1Click, cb)
	end
	local function setHidden(h) win.Visible = not h bubble.Visible = h end
	dot(-62, C.warn, "–", function() setHidden(true) end)
	dot(-34, C.bad, "✕", function() Hub.Kill() end)
	on(bubble.MouseButton1Click, function() setHidden(false) end)
	on(UIS.InputBegan, function(i, gp)
		if not gp and i.KeyCode == Enum.KeyCode.RightShift then setHidden(win.Visible) end
	end)

	-- drag
	do
		local dragging, ds, sp
		on(head.InputBegan, function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging, ds, sp = true, i.Position, win.Position
			end
		end)
		on(UIS.InputChanged, function(i)
			if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local d = i.Position - ds
				win.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X / scale.Scale, sp.Y.Scale, sp.Y.Offset + d.Y / scale.Scale)
			end
		end)
		on(UIS.InputEnded, function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
		end)
	end

	-- segmented control
	local seg = new("Frame", {
		Size = UDim2.new(1, -36, 0, 36), Position = UDim2.fromOffset(18, 62), BackgroundColor3 = C.card, BorderSizePixel = 0,
	}, win)
	round(seg, 11)
	local pill = new("Frame", {
		Size = UDim2.new(1 / #TABS, -4, 1, -6), Position = UDim2.new(0, 3, 0, 3), BackgroundColor3 = C.card2, BorderSizePixel = 0,
	}, seg)
	round(pill, 9)

	local pages, hero, infos = {}, {}, {}
	local pageHost = new("Frame", {
		Size = UDim2.new(1, -36, 1, -180), Position = UDim2.fromOffset(18, 108), BackgroundTransparency = 1, ClipsDescendants = true,
	}, win)

	local cur = 1
	local function setTab(i)
		cur = i
		tween(pill, 0.3, { Position = UDim2.new((i - 1) / #TABS, 3, 0, 3) })
		for k, p in ipairs(pages) do p.Visible = (k == i) end
	end

	for i, t in ipairs(TABS) do
		local b = new("TextButton", {
			Size = UDim2.new(1 / #TABS, 0, 1, 0), Position = UDim2.new((i - 1) / #TABS, 0, 0, 0), BackgroundTransparency = 1,
			Text = t.name, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.tx, ZIndex = 2,
		}, seg)
		on(b.MouseButton1Click, function() setTab(i) end)

		local page = new("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Visible = (i == 1),
		}, pageHost)
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, page)
		pages[i] = page

		local mod = mods[t.key]
		hero[i] = heroCard(page, t.tag, t.title, t.desc)

		if not mod then
			infos[i] = infoCard(page)
			infos[i].Text = "Modul tidak tersedia:\n" .. tostring(errs[t.key] or "tidak diketahui")
			infos[i].TextColor3 = C.bad
		elseif t.key == "Fishing" then
			infos[i] = infoCard(page)
			header(page, "PENGATURAN")
			stepper(page, "Target Power Lempar", function() return mod.CFG.CastTargetPower end,
				function(v) mod.CFG.CastTargetPower = v end, 0.5, 1, 0.05)
			stepper(page, "Jeda Setelah Tangkap (dtk)", function() return mod.CFG.AfterCatchDelay end,
				function(v) mod.CFG.AfterCatchDelay = v end, 1, 8, 0.5)
		elseif t.key == "Tani" then
			infos[i] = infoCard(page)
			header(page, "BIBIT")
			local seedRow = new("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1 }, page)
			local seedBtns = {}
			local function seedRender()
				for n, b2 in pairs(seedBtns) do b2.BackgroundColor3 = (mod.S.Bibit == n) and C.ok or C.card end
			end
			local ns = #mod.Seeds
			for k, n in ipairs(mod.Seeds) do
				local b2 = new("TextButton", {
					Size = UDim2.new(1 / ns, -6, 1, 0), Position = UDim2.new((k - 1) / ns, 0, 0, 0),
					BackgroundColor3 = C.card, Text = n, Font = Enum.Font.GothamMedium, TextSize = 12,
					TextColor3 = C.tx, AutoButtonColor = true,
				}, seedRow)
				round(b2, 10)
				seedBtns[n] = b2
				on(b2.MouseButton1Click, function() mod.SetBibit(n) seedRender() end)
			end
			seedRender()

			local function sw(label, key)
				switchRow(page, label, function() return mod.S[key] end, function(v) mod.S[key] = v mod.Mark() end)
			end
			header(page, "TANAM")
			sw("Auto Cangkul", "Cangkul")
			sw("Auto Tanam", "Tanam")
			header(page, "PANEN / POHON")
			sw("Panen / Cabut", "Panen")
			sw("Petik Buah", "Petik")
			sw("Pungut Buah", "Pungut")
			sw("Goyang Pohon", "Goyang")
			sw("Tebang Pohon", "Tebang")
			sw("Siram", "Siram")
			sw("Prompt Lainnya", "Lain")
			header(page, "PETAK")
			sw("ESP", "ESP")
			stepper(page, "Margin Sel", function() return math.floor(mod.S.Margin * 100 + 0.5) end,
				function(v) mod.SetMargin(v / 100) end, 0, 25, 5, "%s%%")
			actionBtn(page, "Cari Ulang Petak Milikku", function() mod.CariUlang() end)
			actionBtn(page, "Pakai Petak Terdekat", function() mod.PetakTerdekat() end)
			actionBtn(page, "Reset Memori Cangkul", function() mod.ResetMemori() end)
			actionBtn(page, "Dump Prompt (F9)", function() mod.Dump() end)
		elseif t.key == "Dulang" then
			infos[i] = infoCard(page)
			header(page, "AUTO")
			local function fl(label, key)
				switchRow(page, label, function() return mod.set[key] end, function(v) mod.SetFlag(key, v) end)
			end
			fl("Auto Dulang", "dulang")
			fl("Auto Lebur", "lebur")
			header(page, "PENGATURAN")
			fl("Animasi", "animasi")
			fl("Teleport", "teleport")
			fl("Cepat", "cepat")
			fl("Cari Kaya", "kaya")
			fl("ESP Endapan", "esp")
			fl("Probe", "probe")
		elseif t.key == "Ternak" then
			infos[i] = infoCard(page)
			header(page, "PENGATURAN")
			stepper(page, "Isi Pakan Saat ≤ (%)", function() return mod.S.PAKAN_MIN end,
				function(v) mod.S.PAKAN_MIN = v end, 5, 50, 5, "%s%%")
			stepper(page, "Stok Minimum Darurat", function() return mod.S.STOK_MIN end,
				function(v) mod.S.STOK_MIN = v end, 6, 48, 6)
			header(page, "LOKASI")
			switchRow(page, "Kembali ke Lokasi Awal", function() return mod.S.KEMBALI end,
				function(v) mod.S.KEMBALI = v end)
		end
	end

	-- footer
	local go = new("TextButton", {
		Size = UDim2.new(1, -36, 0, 48), Position = UDim2.new(0, 18, 1, -62), BackgroundColor3 = C.ok,
		Text = "Mulai", Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = true,
	}, win)
	round(go, 16)
	on(go.MouseButton1Click, function()
		local mod = mods[TABS[cur].key]
		if mod then mod.SetActive(not mod.IsActive()) end
	end)

	task.spawn(function()
		while Hub.Alive do
			for i, t in ipairs(TABS) do
				local mod = mods[t.key]
				if mod and infos[i] then
					local okI, txt = pcall(mod.Info)
					if okI then infos[i].Text = txt end
					local run = mod.IsActive()
					hero[i].Text = run and "● Berjalan" or "○ Berhenti"
					hero[i].TextColor3 = run and C.ok or C.tx2
				end
			end
			for _, f in ipairs(refreshers) do pcall(f) end
			local mod = mods[TABS[cur].key]
			if mod then
				local run = mod.IsActive()
				go.Text = run and "Berhenti" or "Mulai"
				go.BackgroundColor3 = run and C.bad or C.ok
			else
				go.Text = "Tidak tersedia"
				go.BackgroundColor3 = C.off
			end
			task.wait(0.3)
		end
	end)

	win.Size = UDim2.fromOffset(350, 520)
	setTab(1)
end

-- ---------- ALUR UTAMA ----------
task.spawn(function()
	setProgress(0.1, "Memuat aset…")
	task.wait(0.4)

	local mods, errs = {}, {}
	local list = { { "Fishing", ModFishing }, { "Tani", ModTani }, { "Ternak", ModTernak }, { "Dulang", ModDulang } }
	for i, e in ipairs(list) do
		setProgress(0.15 + 0.17 * (i - 1), "Memuat modul " .. e[1] .. "…")
		local ok, res, err = pcall(e[2])
		if ok and res then
			mods[e[1]] = res
			Hub.Mods[e[1]] = res
		else
			errs[e[1]] = (not ok and tostring(res)) or err or "gagal dimuat"
			warn("[MajapahitRP] " .. e[1] .. ": " .. tostring(errs[e[1]]))
		end
		task.wait(0.3)
	end

	setProgress(0.85, "Menyiapkan menu…")
	task.wait(0.3)
	local okUI, errUI = pcall(buildMain, mods, errs)
	if not okUI then warn("[MajapahitRP UI] " .. tostring(errUI)) end

	setProgress(1, "Selamat datang!")
	task.wait(0.6)
	tween(load, 0.6, { GroupTransparency = 1 })
	task.wait(0.7)
	pcall(function() load:Destroy() end)
end)
