-- MODUL 4: AUTO DULANG + LEBUR
--====================================================================
local function ModDulang()
	local DRoot = RS:WaitForChild("Dulang", 5)
	if not DRoot then return nil, "Sistem Dulang tidak ditemukan di game ini" end
	local Cfg = require(DRoot:WaitForChild("DulangConfig"))
	local R = DRoot:WaitForChild("Remotes")
	local Aksi, Lebur = R:WaitForChild("Dulang_Aksi"), R:WaitForChild("Dulang_Lebur")

	local running = true
	local status = "Siap"
	local set = { dulang = false, lebur = false, animasi = true, teleport = true, cepat = false, kaya = false, esp = true, probe = false }
	local SKOR = { goyang = 1, kerikil = 1, bilas = 1, pungut = 1 }

	-- ===== ESP endapan =====
	local espFolder = Instance.new("Folder")
	espFolder.Name = "EspDulang"
	espFolder.Parent = workspace.CurrentCamera
	local spots = {}

	local function warnaSpot(label, habis)
		label = tostring(label or "")
		if habis then return Color3.fromRGB(140, 140, 140) end
		if label:find("Kaya") then return Color3.fromRGB(80, 255, 100) end
		if label:find("Sedang") then return Color3.fromRGB(255, 220, 70) end
		return Color3.fromRGB(255, 80, 70)
	end

	local function catat(pos, label, habis)
		local s
		for _, v in spots do
			if (v.pos - pos).Magnitude < 8 then s = v break end
		end
		if not s then
			local p = Instance.new("Part")
			p.Shape = Enum.PartType.Cylinder
			p.Size = Vector3.new(0.3, Cfg.RADIUS_TITIK * 2, Cfg.RADIUS_TITIK * 2)
			p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
			p.Material = Enum.Material.Neon
			p.Transparency = 0.7
			p.Parent = espFolder

			local bb = Instance.new("BillboardGui")
			bb.Size = UDim2.fromOffset(160, 40)
			bb.StudsOffset = Vector3.new(0, 6, 0)
			bb.AlwaysOnTop = true
			bb.Adornee = p
			bb.Parent = p
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundTransparency = 1
			t.Font = Enum.Font.GothamBold
			t.TextSize = 14
			t.TextStrokeTransparency = 0
			t.Parent = bb

			s = { pos = pos, part = p, txt = t }
			table.insert(spots, s)
		end
		local w = warnaSpot(label, habis)
		s.part.Color = w
		s.txt.TextColor3 = w
		s.txt.Text = tostring(label or "?") .. (habis and " (habis)" or "")
	end

	-- ===== Handler bawaan game dimatikan =====
	local disabledConns = {}
	if getconnections then
		for _, sig in { Aksi.OnClientEvent, Lebur.OnClientEvent } do
			for _, c in getconnections(sig) do
				local ok = pcall(function() c:Disable() end)
				if ok then table.insert(disabledConns, c) end
			end
		end
	end

	local S = { d = {}, l = {} }
	local myConns = {}
	local function listen(remote, st, isDulang)
		table.insert(myConns, remote.OnClientEvent:Connect(function(a, data)
			if a == "mulai" and type(data) == "table" then
				st.data = data
				if isDulang then
					local h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
					if h then catat(h.Position - Vector3.new(0, 3, 0), data.label, data.habis) end
				end
			elseif a == "hasil" and type(data) == "table" then
				st.hasil = data
			elseif a == "batal" then
				st.batal = true
			end
		end))
	end
	listen(Aksi, S.d, true)
	listen(Lebur, S.l, false)

	local function reset(st) st.data, st.hasil, st.batal = nil, nil, false end
	local function tunggu(st, key, timeout)
		local t = os.clock()
		while running and not st[key] and not st.batal and os.clock() - t < timeout do task.wait() end
		return st[key]
	end

	local function dur(normal, min)
		if set.cepat then return min + 0.1 end
		return normal
	end

	local function hrpGet()
		return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	end
	local function humGet()
		return LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	end

	local function equip()
		local char = LP.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return false end
		for _, c in char:GetChildren() do
			if c:IsA("Tool") and c:GetAttribute("DulangTingkat") then return true end
		end
		for _, t in LP.Backpack:GetChildren() do
			if t:IsA("Tool") and t:GetAttribute("DulangTingkat") then
				hum:EquipTool(t)
				task.wait(set.cepat and 0.15 or 0.4)
				return true
			end
		end
		return false
	end

	-- ===== Animasi karakter =====
	local tracks, lastChar = {}, nil
	local LOOP = { Goyang = true, Bilas = true, IdleJongkok = true, PegangJalan = true }
	local PRI = {
		PegangJalan = Enum.AnimationPriority.Action,
		IdleJongkok = Enum.AnimationPriority.Action,
		AmbilTanah = Enum.AnimationPriority.Action2,
		Goyang = Enum.AnimationPriority.Action2,
		Bilas = Enum.AnimationPriority.Action2,
		BuangKerikil = Enum.AnimationPriority.Action3,
		PungutEmas = Enum.AnimationPriority.Action3,
	}

	local function getTrack(nama)
		local id = Cfg.ANIM[nama]
		local hum = humGet()
		local animator = hum and hum:FindFirstChildOfClass("Animator")
		if not (id and animator) then return nil end
		if lastChar ~= LP.Character then tracks, lastChar = {}, LP.Character end
		if tracks[nama] then return tracks[nama] end
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, t = pcall(function() return animator:LoadAnimation(a) end)
		if not ok or not t then return nil end
		t.Priority = PRI[nama] or Enum.AnimationPriority.Action2
		t.Looped = LOOP[nama] == true
		tracks[nama] = t
		return t
	end

	local function play(nama)
		for n, t in tracks do
			if n ~= "IdleJongkok" and n ~= "PegangJalan" and n ~= nama and t.IsPlaying then
				t:Stop(0.1)
			end
		end
		local t = getTrack(nama)
		if t then
			if t.IsPlaying then t:Stop(0) end
			t:Play(0.1)
		end
		return t
	end

	local function stopAllAnim()
		for _, t in tracks do
			if t.IsPlaying then t:Stop(0.15) end
		end
	end

	-- ===== Cari titik air di zona mendulang =====
	local titikAir, idxAir, asalCF = {}, 0, nil

	local function scanAir()
		titikAir = {}
		local c, u = Cfg.ZONA_PUSAT, Cfg.ZONA_UKURAN
		local reg = Region3.new(c - u / 2, c + u / 2):ExpandToGrid(4)
		local ok, mats, occ = pcall(function() return workspace.Terrain:ReadVoxels(reg, 4) end)
		if not ok then return end
		local size = mats.Size
		local min = reg.CFrame.Position - reg.Size / 2
		for x = 1, size.X do
			for z = 1, size.Z do
				for y = size.Y, 1, -1 do
					if mats[x][y][z] == Enum.Material.Water and occ[x][y][z] > 0.5 then
						local bawah = y > 1 and mats[x][y - 1][z] == Enum.Material.Water
						if bawah then
							table.insert(titikAir, min + Vector3.new((x - 0.5) * 4, (y - 0.5) * 4, (z - 0.5) * 4))
						end
						break
					end
				end
			end
		end
		for i = #titikAir, 2, -1 do
			local j = math.random(i)
			titikAir[i], titikAir[j] = titikAir[j], titikAir[i]
		end
	end

	local function keAir(lompat)
		local hrp = hrpGet()
		if not hrp then return false end
		if #titikAir == 0 then scanAir() end
		if #titikAir == 0 then titikAir = { Cfg.ZONA_PUSAT } end
		if not asalCF then asalCF = hrp.CFrame end
		if lompat then idxAir = idxAir % #titikAir + 1 end
		idxAir = math.max(idxAir, 1)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(titikAir[idxAir] + Vector3.new(0, 1.5, 0))
		task.wait(set.cepat and 0.3 or 0.8)
		return true
	end

	local function kembali()
		local hrp = hrpGet()
		if hrp and asalCF then hrp.CFrame = asalCF end
		asalCF = nil
	end

	-- ===== Siklus dulang =====
	local FASE_ANIM = {
		{ "AmbilTanah", 2.0 },
		{ "Goyang", 6.5 },
		{ "BuangKerikil", 4.5 },
		{ "Bilas", 8.5 },
		{ "PungutEmas", 5.0 },
	}

	local function cycleDulang()
		local st = S.d
		reset(st)
		Aksi:FireServer("mulai")
		if not tunggu(st, "data", 3) then return false end
		local tok = st.data.token

		if st.data.habis or (set.kaya and not tostring(st.data.label or ""):find("Kaya")) then
			Aksi:FireServer("batal", tok)
			task.wait(0.3)
			return "pindah"
		end

		status = "Mendulang: " .. tostring(st.data.label or "?")

		if not set.animasi then
			for i = 1, 4 do
				task.wait(dur(Cfg.MIN_FASE[i] + 0.3, Cfg.MIN_FASE[i]))
				if not running then Aksi:FireServer("batal", tok) return true end
				if st.batal then return true end
				Aksi:FireServer("fase", tok, i + 1)
			end
			task.wait(dur(Cfg.MIN_FASE[5] + 0.3, Cfg.MIN_FASE[5]))
			if not running then Aksi:FireServer("batal", tok) return true end
			if st.batal then return true end
			Aksi:FireServer("selesai", tok, SKOR)
			tunggu(st, "hasil", 6)
			return true
		end

		local hum = humGet()
		local ws, jp, jh, ar
		if hum then
			ws, jp, jh, ar = hum.WalkSpeed, hum.JumpPower, hum.JumpHeight, hum.AutoRotate
			hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = 0, 0, 0
		end
		local pegang = getTrack("PegangJalan")
		if pegang and pegang.IsPlaying then pegang:Stop(0.15) end
		local jongkok = getTrack("IdleJongkok")
		if jongkok and not jongkok.IsPlaying then jongkok:Play(0.15) end

		local ok = true
		for i, f in FASE_ANIM do
			if not running or st.batal or not set.dulang then ok = false break end
			play(f[1])
			if set.cepat then
				task.wait(Cfg.MIN_FASE[i] + 0.1)
			else
				task.wait(f[2] + math.random() * 0.4)
			end
			if not running or st.batal then ok = false break end
			if i < 5 then Aksi:FireServer("fase", tok, i + 1) end
		end

		if ok then
			stopAllAnim()
			Aksi:FireServer("selesai", tok, SKOR)
			tunggu(st, "hasil", 6)
		elseif not st.batal then
			Aksi:FireServer("batal", tok)
		end

		stopAllAnim()
		if jongkok and jongkok.IsPlaying then jongkok:Stop(0.15) end
		hum = humGet()
		if hum then
			hum.WalkSpeed = (ws and ws > 0) and ws or 16
			hum.JumpPower = jp or 50
			hum.JumpHeight = jh or 7.2
			hum.AutoRotate = ar ~= false
		end
		if running then
			local p2 = getTrack("PegangJalan")
			if p2 and not p2.IsPlaying then p2:Play(0.2) end
		end
		return true
	end

	local function posisiTungku()
		local z = workspace:FindFirstChild("ZonaMendulangEmas")
		local t = z and z:FindFirstChild("PandeEmas") and z.PandeEmas:FindFirstChild("TitikLebur")
		if not t then return nil end
		return (t:IsA("BasePart") and t.Position or t:GetPivot().Position)
	end

	local function cycleLebur()
		local mg = LP:GetAttribute("SerbukEmasMg") or 0
		local n = math.min(Cfg.LEBUR_MAKS_SEKALI, math.floor(mg / (Cfg.BATANGAN_GRAM * 1000)))
		if n < 1 then return false end

		status = "Melebur " .. n .. " batangan"
		local hrp = hrpGet()
		if not hrp then return false end
		local asal
		if set.teleport then
			local pos = posisiTungku()
			if not pos then return false end
			asal = hrp.CFrame
			hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
			task.wait(set.cepat and 0.25 or 0.6)
		end

		local st = S.l
		reset(st)
		Lebur:FireServer("mulai", n)
		if tunggu(st, "data", 3) then
			local tok = st.data.token
			if set.animasi then play("PompaUbub") end
			task.wait(dur(8.5, Cfg.LEBUR_MIN[1]))
			if not running then Lebur:FireServer("batal", tok) stopAllAnim() return true end
			Lebur:FireServer("fase", tok, 2)
			if set.animasi then play("TuangCetakan") end
			task.wait(dur(3 + n * 1.5, Cfg.LEBUR_MIN[2]))
			if not running then Lebur:FireServer("batal", tok) stopAllAnim() return true end
			Lebur:FireServer("selesai", tok, true)
			tunggu(st, "hasil", 6)
			if set.animasi and running and not set.cepat then
				play("AngkatBatangan")
				task.wait(2)
			end
			stopAllAnim()
		end

		task.wait(set.cepat and 0.15 or 0.5)
		local h = hrpGet()
		if h and asal then h.CFrame = asal end
		return true
	end

	-- ===== Loop utama =====
	local gagal = 0
	local sedangAktif = false
	task.spawn(function()
		while running do
			task.wait(set.cepat and 0.05 or 0.2)
			if not running then break end
			local mg = LP:GetAttribute("SerbukEmasMg") or 0
			if set.lebur and mg >= Cfg.BATANGAN_GRAM * 1000 then
				pcall(cycleLebur)
				task.wait(set.cepat and 0.2 or 1)
				if running and set.dulang and set.teleport then keAir(false) end
			elseif set.dulang then
				sedangAktif = true
				if equip() then
					if set.teleport then
						local hrp = hrpGet()
						if hrp and (not asalCF or (hrp.Position - (titikAir[idxAir] or hrp.Position)).Magnitude > 25) then
							keAir(false)
						end
					end
					local ok, berhasil = pcall(cycleDulang)
					if ok and berhasil == "pindah" then
						status = "Endapan tidak cocok, pindah titik"
						if set.teleport then keAir(true) end
						gagal = 0
					elseif ok and berhasil then
						gagal = 0
					else
						gagal += 1
						if gagal >= 2 then
							if set.teleport then keAir(true) end
							gagal = 0
						end
					end
				else
					status = "Dulang tidak ada di tas"
				end
				task.wait(dur(Cfg.JEDA + 0.3, Cfg.JEDA))
			elseif sedangAktif then
				sedangAktif = false
				status = "Siap"
				kembali()
			end
		end
	end)

	-- ===== Probe: cek endapan otomatis saat berjalan (tanpa dulang) =====
	task.spawn(function()
		local last
		while running do
			task.wait(2.7)
			if running and set.probe and not set.dulang then
				local hrp = hrpGet()
				if hrp and equip() and (not last or (hrp.Position - last).Magnitude > 10) then
					last = hrp.Position
					reset(S.d)
					Aksi:FireServer("mulai")
					if tunggu(S.d, "data", 3) then
						Aksi:FireServer("batal", S.d.data.token)
					end
				end
			end
		end
	end)

	-- ===== API untuk UI =====
	local M = { set = set }
	function M.SetActive(v)
		set.dulang, set.lebur = v and true or false, v and true or false
	end
	function M.IsActive() return set.dulang or set.lebur end
	function M.SetFlag(k, v)
		set[k] = v and true or false
		if k == "esp" then espFolder.Parent = set.esp and workspace.CurrentCamera or nil end
	end
	function M.Info()
		return ("Serbuk emas: %s mg | Titik air: %d\nEndapan terdeteksi: %d\nStatus: %s"):format(
			tostring(LP:GetAttribute("SerbukEmasMg") or 0), #titikAir, #spots, status)
	end
	function M.Kill()
		running = false
		set.dulang, set.lebur, set.probe = false, false, false
		for _, c in myConns do pcall(function() c:Disconnect() end) end
		for _, c in disabledConns do pcall(function() c:Enable() end) end
		stopAllAnim()
		local hum = humGet()
		if hum then
			if hum.WalkSpeed == 0 then hum.WalkSpeed = 16 end
			if hum.JumpPower == 0 then hum.JumpPower = 50 end
			if hum.JumpHeight == 0 then hum.JumpHeight = 7.2 end
			hum.AutoRotate = true
		end
		if asalCF then kembali() end
		pcall(function() espFolder:Destroy() end)
	end
	return M
end

