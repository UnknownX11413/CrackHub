		Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.gold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
end

local function infoCard(parent)
	local card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.card, BorderSizePixel = 0,
	}, parent)
	round(card, 12)
	new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, card)
	return new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		Text = "-", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.tx2, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	}, card)
end

local refreshers = {}
local function switchRow(parent, text, get, set)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = C.card, BorderSizePixel = 0 }, parent)
	round(row, 12)
	new("TextLabel", {
		Size = UDim2.new(1, -70, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
		Text = text, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = C.tx,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local sw = new("TextButton", {
		Size = UDim2.fromOffset(46, 26), Position = UDim2.new(1, -56, 0.5, -13),
		BackgroundColor3 = C.off, Text = "", AutoButtonColor = false,
	}, row)
	round(sw, 13)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(2, 2),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, sw)
	round(knob, 11)
	local last
	local function render()
		local v = get() and true or false
		if v == last then return end
		last = v
		tween(sw, 0.2, { BackgroundColor3 = v and C.ok or C.off })
		tween(knob, 0.2, { Position = v and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2) })
	end
	on(sw.MouseButton1Click, function() set(not get()) render() end)
	render()
	table.insert(refreshers, render)
	return row
end

local function stepper(parent, text, get, set, minv, maxv, stp, fmt)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = C.card, BorderSizePixel = 0 }, parent)
	round(row, 12)
	new("TextLabel", {
		Size = UDim2.new(1, -150, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
		Text = text, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = C.tx,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local val = new("TextLabel", {
		Size = UDim2.fromOffset(54, 28), Position = UDim2.new(1, -96, 0.5, -14), BackgroundTransparency = 1,
		Text = "", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.gold,
	}, row)
	local function render() val.Text = (fmt or "%s"):format(tostring(get())) end
	local function btn(txt, x, dir)
		local b = new("TextButton", {
			Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, x, 0.5, -14),
			BackgroundColor3 = C.card2, Text = txt, Font = Enum.Font.GothamBold, TextSize = 16,
			TextColor3 = C.tx, AutoButtonColor = true,
		}, row)
		round(b, 8)
		on(b.MouseButton1Click, function()
			local v = math.clamp(math.floor((get() + dir * stp) * 1000 + 0.5) / 1000, minv, maxv)
			set(v)
			render()
		end)
	end
	btn("−", -128, -1)
	btn("+", -38, 1)
	render()
	return row
end

local function actionBtn(parent, text, cb)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = C.card2, Text = text,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.tx, AutoButtonColor = true,
	}, parent)
	round(b, 12)
	on(b.MouseButton1Click, cb)
	return b
end

local function heroCard(parent, tag, title, desc)
