-- MAJAPAHIT RP V1 | Hub: Auto Fishing + Auto Tani + Auto Ternak (1 UI, ala iOS)
-- Tombol RightShift = tampil/sembunyi menu. Titik kuning = minimize, titik merah = matikan semua.

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")
local CS = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local LP = Players.LocalPlayer
local PG = LP:WaitForChild("PlayerGui")

if getgenv then
	local old = getgenv().MajapahitHub
	if old and old.Kill then pcall(old.Kill) end
end

local Hub = { Alive = true, Conns = {}, Mods = {} }
if getgenv then getgenv().MajapahitHub = Hub end

local function on(sig, fn)
	local c = sig:Connect(fn)
	table.insert(Hub.Conns, c)
	return c
end

local gui = Instance.new("ScreenGui")
gui.Name = "MajapahitRP_V1"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")

Hub.Kill = function()
	Hub.Alive = false
	for _, m in pairs(Hub.Mods) do
		if m.Kill then pcall(m.Kill) end
	end
	for _, c in ipairs(Hub.Conns) do pcall(function() c:Disconnect() end) end
	pcall(function() gui:Destroy() end)
	if getgenv then getgenv().MajapahitHub = nil end
end

--====================================================================
-- MODUL 1: AUTO FISHING
--====================================================================
local function ModFishing()
	local FS = RS:WaitForChild("FishingSystem", 5)
	local Modules = FS and FS:WaitForChild("FishingModules", 5)
	if not Modules then return nil, "FishingSystem tidak ditemukan di game ini" end

	local GUIManager = require(Modules:WaitForChild("GUIManager"))
	local MinigameSystem = require(Modules:WaitForChild("MinigameSystem"))
	local PowerBarSystem = require(Modules:WaitForChild("PowerBarSystem"))

	local CFG = {
		CastTargetPower = 0.95,
		MinHold = 0.6,
		CastChargeTimeout = 3.5,
		BiteTimeout = 45,
		AfterCatchDelay = 2.5,
		PredictGain = 0.28,
		ClickPos = nil,
	}

	local running = false
	local caught = 0
	local holding = false
	local isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled

	local function clickPos()
		if CFG.ClickPos then return CFG.ClickPos end
		local v = workspace.CurrentCamera.ViewportSize
		return Vector2.new(v.X * 0.5, v.Y * 0.25)
	end

	local function mouse(down)
		local p = clickPos()
		VIM:SendMouseButtonEvent(p.X, p.Y, 0, down, game, 0)
	end

	local function setHold(state)
		if holding == state then return end
		holding = state
		if isMobile then
			local btn = GUIManager:GetElement("tapMobileButton")
			if btn then
				local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
				VIM:SendTouchEvent(1, state and 0 or 2, pos.X, pos.Y + 36)
			end
		else
			mouse(state)
		end
	end

	local function getChar()
		local c = LP.Character
		if not c then return end
		local hum = c:FindFirstChildOfClass("Humanoid")
		local hrp = c:FindFirstChild("HumanoidRootPart")
		if hum and hrp and hum.Health > 0 then return c, hum, hrp end
	end

	local function ensureRod(char, hum)
		for _, t in ipairs(char:GetChildren()) do
			if t:IsA("Tool") and CS:HasTag(t, "Rod") and t:FindFirstChild("Part") then
				return t
			end
		end
		local bp = LP:FindFirstChild("Backpack")
		if bp then
			for _, t in ipairs(bp:GetChildren()) do
				if t:IsA("Tool") and CS:HasTag(t, "Rod") then
					hum:EquipTool(t)
					task.wait(0.8)
					return t
				end
			end
		end
	end

	local function powerFill()
		local f = GUIManager:GetElement("fillFrame")
		if not f then return 0 end
		local p = f.Parent
		local r = 0
		if p and p:IsA("GuiObject") and p.AbsoluteSize.X > 0 and p.AbsoluteSize.Y > 0 then
			r = math.max(f.AbsoluteSize.X / p.AbsoluteSize.X, f.AbsoluteSize.Y / p.AbsoluteSize.Y)
		end
		return math.max(r, f.Size.X.Scale, f.Size.Y.Scale)
	end

	local function doCast(rod)
		if isMobile then
			local btn = GUIManager:GetElement("tapMobileButton")
			if not btn then return false end
			firesignal(btn.MouseButton1Click)
			local t0 = os.clock()
			while running and os.clock() - t0 < CFG.CastChargeTimeout do
				if os.clock() - t0 >= CFG.MinHold and powerFill() >= CFG.CastTargetPower then break end
				task.wait()
			end
			firesignal(btn.MouseButton1Click)
			return true
		end

		mouse(true)
		task.wait(0.1)
		if not PowerBarSystem:IsCharging() then
			PowerBarSystem:StartCharging(rod.Name)
		end

		local t0 = os.clock()
		while running and os.clock() - t0 < 1 and not PowerBarSystem:IsCharging() do task.wait() end

		t0 = os.clock()
		while running and os.clock() - t0 < CFG.CastChargeTimeout do
			if os.clock() - t0 >= CFG.MinHold and powerFill() >= CFG.CastTargetPower then break end
			task.wait()
		end

		mouse(false)
		task.wait(0.15)

		local retry = 0
		while PowerBarSystem:IsCharging() and retry < 5 do
			mouse(false)
			retry += 1
			task.wait(0.15)
		end
		return true
	end

	local lastZone, lastT = nil, nil
	on(RunService.RenderStepped, function()
		if not running or not MinigameSystem:IsActive() then
			if holding then setHold(false) end
			lastZone, lastT = nil, nil
			return
		end

		local zone = GUIManager:GetElement("reelZone")
		local fish = GUIManager:GetElement("reelFish")
		if not (zone and fish) then return end

		local zx = zone.Position.X.Scale
		local fx = fish.Position.X.Scale
		local now = os.clock()

		local vel = 0
		if lastZone and lastT and now > lastT then
			vel = (zx - lastZone) / (now - lastT)
		end
		lastZone, lastT = zx, now

		setHold((fx - (zx + vel * CFG.PredictGain)) > 0)
	end)

	local function cycle()
		local char, hum = getChar()
		if not char then task.wait(1) return end
		local rod = ensureRod(char, hum)
		if not rod then task.wait(1) return end

		if MinigameSystem:IsActive() then task.wait(0.2) return end

		doCast(rod)
		if not running then return end

		local t0 = os.clock()
		while running and not MinigameSystem:IsActive() and os.clock() - t0 < CFG.BiteTimeout do
			task.wait(0.1)
		end

		if MinigameSystem:IsActive() then
			while running and MinigameSystem:IsActive() do task.wait(0.1) end
			setHold(false)
			caught += 1
			task.wait(CFG.AfterCatchDelay)
		else
			task.wait(3)
		end
	end

	local function setRunning(v)
		running = v and true or false
		if not running then
			setHold(false)
			if PowerBarSystem:IsCharging() then mouse(false) end
		end
	end

	task.spawn(function()
		while Hub.Alive do
			if running then pcall(cycle) end
			task.wait(0.3)
		end
	end)

	return {
		CFG = CFG,
		SetActive = setRunning,
		IsActive = function() return running end,
		Kill = function() setRunning(false) end,
		Info = function() return ("Tertangkap: %d"):format(caught) end,
	}
end

--====================================================================
-- MODUL 2: AUTO TANI
--====================================================================
local function ModTani()
	local Tani = RS:WaitForChild("Tani", 5)
	if not Tani then return nil, "Folder Tani tidak ditemukan di game ini" end
	local Cfg = require(Tani:WaitForChild("TaniConfig"))
	local Aksi = Tani:WaitForChild("Tani_Aksi")

	local S = {
		Run = true, Aktif = false, ESP = true,
		Cangkul = true, Tanam = true,
		Bibit = (Cfg.URUT_BIBIT and Cfg.URUT_BIBIT[1]) or "Bibit Padi",
		Panen = true, Petik = true, Pungut = true, Goyang = true, Tebang = true, Siram = true, Lain = false,
		Margin = 0, Force = nil, Conns = {}, Native = {},
	}
	if getgenv then getgenv().AutoTani = S end

	local DEPAN = Cfg.JARAK_DEPAN or 3.5
	local N = Cfg.RUMPUN_PER_SISI or 4
	local dirty, goyangBusy, addTick = true, false, 0
	local status = "Siap"
	local Ps, pconns, hooked = {}, {}, {}
	local cool, fails, failUntil = {}, {}, {}
	local gen = 0
	local curKey = nil
	local plantKey = setmetatable({}, { __mode = "k" })
	local plantT = setmetatable({}, { __mode = "k" })
	local D = { acts = {}, empties = {}, emptyKeys = {}, esp = {}, n = { kosong = 0, siap = 0, tumbuh = 0, tebang = 0 } }

	-- ===== MEMORI TANAH PER SEL =====
	local soil = {}
	local function getSoil(k)
		local s = soil[k]
		if not s then
			s = { stage = "rata", hits = 0, tries = 0, t = 0 }
			soil[k] = s
		end
		return s
	end
	local function setStage(s, st)
		s.stage, s.hits, s.t = st, 0, os.clock()
	end

	local HOE = { ["Bibit Padi"] = 2, ["Bibit Pisang"] = 3 }
	local function hoeCount(b)
		return HOE[b] or (Cfg.GUNDUKAN and Cfg.GUNDUKAN.CANGKUL_KALI) or 3
	end

	local function legacy(b)
		b = b or S.Bibit
		local d = Cfg.BIBIT and Cfg.BIBIT[b]
		local t = d and Cfg.TANAMAN and Cfg.TANAMAN[d.jenis]
		return (t and t.gundukan) or b == "Bibit Pisang"
	end

	local tilled, tillUntil = setmetatable({}, { __mode = "k" }), 0
	local moundWords = { "gundukan", "mound", "tanah", "cangkul", "lubang", "dig", "soil", "bedeng" }
	local function isTilled(c)
		if tilled[c] then return true end
		local n = c.Name:lower()
		for _, w in ipairs(moundWords) do if n:find(w, 1, true) then return true end end
		return false
	end

	local anchors = Instance.new("Folder")
	anchors.Name = "AT_" .. math.random(10000, 99999)
	anchors.Parent = workspace

	local function mark() dirty = true end
	local function bind(sig, fn) local c = sig:Connect(fn) table.insert(S.Conns, c) return c end
	local function clearP() for _, c in ipairs(pconns) do pcall(function() c:Disconnect() end) end table.clear(pconns) table.clear(hooked) end

	local espGui = Instance.new("Folder")
	espGui.Name = "ESP"
	espGui.Parent = gui

	S.Stop = function()
		S.Run = false S.Aktif = false
		for _, c in ipairs(S.Conns) do pcall(function() c:Disconnect() end) end
		clearP()
		for _, c in ipairs(S.Native) do pcall(function() c:Enable() end) end
		pcall(function() espGui:Destroy() end)
		pcall(function() anchors:Destroy() end)
	end

	-- ===== util =====
	local function hum() local c = LP.Character return c and c:FindFirstChildOfClass("Humanoid") end
	local function hrp() local c = LP.Character return c and c:FindFirstChild("HumanoidRootPart") end
	local function alive() local h = hum() return h and h.Health > 0 and hrp() end
	local function flat(v) return Vector3.new(v.X, 0, v.Z) end
	local function d2(a, b) return (flat(a) - flat(b)).Magnitude end
	local function unit(v, fb) v = flat(v) return v.Magnitude > 0.05 and v.Unit or fb end

	local function posOf(o)
		if o:IsA("Model") then return o:GetPivot().Position end
		if o:IsA("BasePart") then return o.Position end
	end

	local function findTool(name)
		for _, par in ipairs({ LP.Character, LP.Backpack }) do
			if par then
				for _, t in ipairs(par:GetChildren()) do
					if t:IsA("Tool") and (t.Name == name or t.Name:find(name, 1, true) == 1) then return t end
				end
			end
		end
	end

	local function equip(name)
		local t, h = findTool(name), hum()
		if not (t and h) then return nil end
		if t.Parent ~= LP.Character then h:EquipTool(t) task.wait(0.25) end
		return t
	end

	local function tpTo(pos, face, gy)
		local r, h = hrp(), hum()
		if not (r and h) then return end
		if not gy then
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Exclude
			rp.FilterDescendantsInstances = { LP.Character, anchors }
			local hit = workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -40, 0), rp)
			gy = hit and hit.Position.Y or pos.Y
		end
		local p = Vector3.new(pos.X, gy + h.HipHeight + r.Size.Y / 2 + 0.1, pos.Z)
		local f = Vector3.new(face.X, p.Y, face.Z)
		if (f - p).Magnitude < 0.1 then f = p + Vector3.new(0, 0, -1) end
		r.AssemblyLinearVelocity = Vector3.zero
		r.CFrame = CFrame.lookAt(p, f)
	end

	-- ===== kepemilikan =====
	local ownerKeys = { "Owner", "owner", "Pemilik", "OwnerId", "UserId", "Player", "PlayerId" }
	local function isMine(v)
		return v ~= nil and (v == LP.UserId or v == LP.Name or v == LP.DisplayName or tostring(v) == tostring(LP.UserId))
	end
	local function ownerAttr(o)
		for _, k in ipairs(ownerKeys) do
			local v = o:GetAttribute(k)
			if v ~= nil then return v end
		end
	end
	local function promptOwner(p)
		local o = p
		for _ = 1, 5 do
			if not o or o == workspace then break end
			local v = ownerAttr(o)
			if v ~= nil then return v end
			o = o.Parent
		end
	end
	local function ownerOk(p)
		local v = promptOwner(p)
		return v == nil or v == 0 or v == "0" or v == "" or isMine(v)
	end

	local function objMine(o)
		local v = ownerAttr(o)
		if v ~= nil and isMine(v) then return true end
		if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
			local t = o.Text:lower()
			if t:find(LP.Name:lower(), 1, true) or t:find(LP.DisplayName:lower(), 1, true) then return true end
		elseif o:IsA("StringValue") or o:IsA("IntValue") or o:IsA("NumberValue") then
			if isMine(o.Value) then return true end
		elseif o:IsA("ObjectValue") and o.Value == LP then
			return true
		end
		return false
	end

	local function petakMine(pt)
		if objMine(pt) then return true end
		for _, o in ipairs(pt:GetDescendants()) do
			if objMine(o) then return true end
		end
		return false
	end

	-- ===== petak =====
	local function nearestPetak(all)
		local r = hrp()
		local best, bd
		for _, p in ipairs(all) do
			local d = r and (p.area.Position - r.Position).Magnitude or 0
			if not bd or d < bd then best, bd = p, d end
		end
		return best
	end

	local function reload()
		clearP()
		local all = {}
		for _, f in ipairs(workspace:GetDescendants()) do
			if f.Name == "TaniSel" and f:IsA("Folder") then
				local pt = f.Parent
				local area = pt and pt:FindFirstChild("Area")
				if area and area:IsA("BasePart") then all[#all + 1] = { pt = pt, area = area, sel = f, off = Vector3.zero } end
			end
		end
		local own = {}
		if S.Force then
			for _, p in ipairs(all) do if p.pt == S.Force then own[1] = p end end
		else
			for _, p in ipairs(all) do if petakMine(p.pt) then own[#own + 1] = p end end
		end
		if #own == 0 then status = "Petak milikmu belum terdeteksi: tekan 'Petak Terdekat'" end
		for i, P in ipairs(own) do
			P.id = i
			table.insert(pconns, P.sel.ChildAdded:Connect(function(c)
				if not legacy() and (os.clock() < tillUntil or isTilled(c)) then
					tilled[c] = true
				else
					addTick = addTick + 1
					plantT[c] = os.clock()
					if curKey then plantKey[c] = curKey end
				end
				table.insert(pconns, c.AttributeChanged:Connect(mark))
				mark()
			end))
			table.insert(pconns, P.sel.ChildRemoved:Connect(mark))
			table.insert(pconns, P.sel.DescendantAdded:Connect(mark))
			table.insert(pconns, P.sel.DescendantRemoving:Connect(mark))
			for _, c in ipairs(P.sel:GetChildren()) do table.insert(pconns, c.AttributeChanged:Connect(mark)) end
		end
		Ps = own
		table.clear(cool) table.clear(failUntil) table.clear(fails)
		mark()
	end

	bind(CS:GetInstanceAddedSignal("PromptTani"), mark)
	bind(CS:GetInstanceRemovedSignal("PromptTani"), mark)
	bind(LP.CharacterAdded, function() task.wait(1) mark() end)

	-- ===== klasifikasi =====
	local cats = {
		{ "Goyang", { "goyang" }, 0.5 },
		{ "Tebang", { "tebang", "tebas", "kapak" }, 2 },
		{ "Petik",  { "petik" }, Cfg.DURASI.Petik },
		{ "Pungut", { "pungut", "ambil" }, Cfg.DURASI.Pungut },
		{ "Panen",  { "panen", "cabut", "tuai", "sabit", "ikat", "ketam" }, Cfg.DURASI.Cabut },
		{ "Siram",  { "siram" }, 1 },
	}
	local function classify(p)
		local txt = ((p.ActionText or "") .. " " .. (p.ObjectText or "") .. " " .. p.Name):lower()
		for _, c in ipairs(cats) do
			for _, k in ipairs(c[2]) do
				if txt:find(k, 1, true) then return c[1], c[3] end
			end
		end
		return "Lain", 1
	end
	local function promptPart(p)
		local a = p.Parent
		if a and a:IsA("BasePart") then return a end
		if a and a:IsA("Attachment") then return a.Parent end
		return a and a:FindFirstChildWhichIsA("BasePart", true)
	end

	local labels = {
		Goyang = { "GOYANG", Color3.fromRGB(255, 170, 60) },
		Tebang = { "TEBANG", Color3.fromRGB(235, 60, 50) },
		Petik  = { "PETIK", Color3.fromRGB(255, 225, 80) },
		Pungut = { "PUNGUT", Color3.fromRGB(255, 225, 80) },
		Panen  = { "SIAP PANEN", Color3.fromRGB(90, 235, 90) },
		Siram  = { "SIRAM", Color3.fromRGB(90, 200, 255) },
		Lain   = { "AKSI", Color3.fromRGB(220, 220, 220) },
	}
	local prio = { Tebang = 1, Panen = 2, Petik = 3, Pungut = 4, Goyang = 5 }
	local stageTxt = { rata = "TANAH RATA", gembur = "TANAH GEMBUR", gundukan = "GUNDUKAN" }
	local MOUND_H = 0.8

	local function totalTime(name)
		local ln = (name or ""):lower()
		for k, v in pairs(Cfg.TANAMAN or {}) do
			if ln:find(k:lower(), 1, true) and v.tahap then return v.tahap[#v.tahap] end
		end
		local b = Cfg.BIBIT and Cfg.BIBIT[S.Bibit]
		local t = b and Cfg.TANAMAN and Cfg.TANAMAN[b.jenis]
		return (t and t.tahap and t.tahap[#t.tahap]) or 540
	end

	-- ===== analisis (hanya saat ada update) =====
	local function analyze()
		local padi = not legacy()
		local list, set = {}, {}
		local function add(p)
			if p:IsA("ProximityPrompt") and not set[p] and p.Parent then
				set[p] = true
				list[#list + 1] = p
				if not hooked[p] then
					hooked[p] = true
					table.insert(pconns, p.AttributeChanged:Connect(mark))
					table.insert(pconns, p.AncestryChanged:Connect(mark))
					table.insert(pconns, p:GetPropertyChangedSignal("ActionText"):Connect(mark))
					table.insert(pconns, p:GetPropertyChangedSignal("ObjectText"):Connect(mark))
				end
			end
		end
		for _, p in ipairs(CS:GetTagged("PromptTani")) do add(p) end
		for _, P in ipairs(Ps) do
			for _, o in ipairs(P.sel:GetDescendants()) do add(o) end
		end

		local acts, empties, emptyKeys, esp = {}, {}, {}, {}
		local n = { kosong = 0, siap = 0, tumbuh = 0, tebang = 0 }

		for _, P in ipairs(Ps) do
			if P.area.Parent then
				local cf, sz = P.area.CFrame, P.area.Size
				local m = 1 - S.Margin
				local sp = math.min(sz.X, sz.Z) * m / N
				local top = cf:PointToWorldSpace(Vector3.new(0, sz.Y / 2, 0)).Y
				local cells, byKey = {}, {}
				for i = 0, N - 1 do
					for j = 0, N - 1 do
						local lx = ((i + 0.5) / N - 0.5) * sz.X * m
						local lz = ((j + 0.5) / N - 0.5) * sz.Z * m
						local c = {
							key = P.id .. "_" .. i .. "_" .. j, P = P, top = top, prompts = {},
							pos = cf:PointToWorldSpace(Vector3.new(lx, sz.Y / 2, lz)) + P.off,
						}
						cells[#cells + 1] = c
						byKey[c.key] = c
					end
				end
				local function nearest(pos)
					local bc, bd
					for _, c in ipairs(cells) do
						local d = d2(c.pos, pos)
						if not bd or d < bd then bc, bd = c, d end
					end
					return bc, bd
				end

				-- tanaman -> sel (+ kalibrasi offset otomatis)
				local plants, ox, oz, cnt = {}, 0, 0, 0
				for _, c in ipairs(P.sel:GetChildren()) do
					local ok, pos = pcall(posOf, c)
					if ok and pos and not (padi and isTilled(c)) then
						plants[#plants + 1] = { inst = c, pos = pos }
					end
				end
				for _, pl in ipairs(plants) do
					if not plantKey[pl.inst] then
						local bc, bd = nearest(pl.pos)
						if bc and bd < sp * 0.6 then
							ox += pl.pos.X - bc.pos.X
							oz += pl.pos.Z - bc.pos.Z
							cnt += 1
						end
					end
				end
				if cnt > 0 then
					local lim = sp * 0.3
					local dx, dz = math.clamp(ox / cnt, -lim, lim), math.clamp(oz / cnt, -lim, lim)
					P.off = P.off + Vector3.new(dx, 0, dz)
					for _, c in ipairs(cells) do c.pos = c.pos + Vector3.new(dx, 0, dz) end
				end
				for _, pl in ipairs(plants) do
					local bc = plantKey[pl.inst] and byKey[plantKey[pl.inst]]
					if not bc then
						local b2, bd = nearest(pl.pos)
						if b2 and bd < sp * 0.9 then bc = b2 end
					end
					if bc and not bc.plant then bc.plant = pl.inst end
				end

				-- deteksi gundukan dari tinggi permukaan
				local rp = RaycastParams.new()
				rp.FilterType = Enum.RaycastFilterType.Exclude
				rp.FilterDescendantsInstances = { LP.Character, anchors, P.sel }
				local base
				for _, c in ipairs(cells) do
					local hit = workspace:Raycast(c.pos + Vector3.new(0, 12, 0), Vector3.new(0, -40, 0), rp)
					if hit then
						c.h = hit.Position.Y - top
						base = base and math.min(base, c.h) or c.h
					end
				end
				base = math.min(base or 0, 0)
				for _, c in ipairs(cells) do
					c.mound = c.h ~= nil and (c.h - base) > MOUND_H
				end

				-- prompt -> sel
				for _, p in ipairs(list) do
					if p.Parent and ownerOk(p) then
						local part = promptPart(p)
						if part then
							local lp = cf:PointToObjectSpace(part.Position)
							if math.abs(lp.X) <= sz.X / 2 + 12 and math.abs(lp.Z) <= sz.Z / 2 + 12 and math.abs(lp.Y) <= 40 then
								local cat, dur = classify(p)
								local guess = false
								if cat == "Lain" then
									local txt = ((p.ActionText or "") .. " " .. (p.ObjectText or "")):lower()
									local inSel = p:IsDescendantOf(P.sel) or CS:HasTag(p, "PromptTani")
									if inSel and not txt:find("tumbuh", 1, true) and not txt:find("%d+%s*%%") then
										cat, dur, guess = "Panen", Cfg.DURASI.Cabut or 2.8, true
									end
								end
								local a = { p = p, pos = part.Position, part = part, cat = cat, dur = dur, top = top, P = P, guess = guess }
								local live = p:GetAttribute("Aktif") ~= false and labels[cat] and cat ~= "Lain"
								local bc, bd = nearest(part.Position)
								if live then acts[#acts + 1] = a end
								if bc and bd <= sp * 0.9 then
									table.insert(bc.prompts, a)
								elseif live then
									local lb = labels[cat]
									esp[#esp + 1] = { key = p, pos = part.Position, text = lb[1], color = lb[2] }
									if cat == "Tebang" then n.tebang += 1 elseif cat ~= "Siram" then n.siap += 1 end
								end
							end
						end
					end
				end

				-- status sel
				for _, c in ipairs(cells) do
					local bestA
					for _, a in ipairs(c.prompts) do
						if a.p:GetAttribute("Aktif") ~= false and prio[a.cat] and (not bestA or prio[a.cat] < prio[bestA.cat]) then bestA = a end
					end
					if bestA then
						local lb = labels[bestA.cat]
						local txt = lb[1]
						if bestA.guess then txt = txt .. " [" .. tostring(bestA.p.ActionText) .. "]" end
						esp[#esp + 1] = { key = c.key, pos = c.pos, text = txt, color = lb[2] }
						if bestA.cat == "Tebang" then n.tebang += 1 else n.siap += 1 end
						soil[c.key] = nil
					elseif c.plant or #c.prompts > 0 then
						n.tumbuh += 1
						soil[c.key] = nil
						local pct
						for _, a in ipairs(c.prompts) do
							local t = (a.p.ActionText or "") .. " " .. (a.p.ObjectText or "")
							local pc = t:match("(%d+)%s*%%")
							if pc then pct = tonumber(pc) break end
						end
						if not pct and c.plant and plantT[c.plant] then
							pct = math.floor(math.min(99, (os.clock() - plantT[c.plant]) / totalTime(c.plant.Name) * 100))
						end
						esp[#esp + 1] = {
							key = c.key, pos = c.pos,
							text = pct and ("TUMBUH " .. pct .. "%") or "TUMBUH",
							color = Color3.fromRGB(170, 210, 120),
						}
					else
						n.kosong += 1
						empties[#empties + 1] = c
						emptyKeys[c.key] = true
						local s = soil[c.key]
						if c.mound and (not s or (s.stage == "rata" and os.clock() - s.t > 3)) then
							s = getSoil(c.key)
							setStage(s, "gundukan")
						end
						local txt = stageTxt[s and s.stage or "rata"]
						if s and s.hits > 0 then txt = txt .. " (" .. s.hits .. "x)" end
						esp[#esp + 1] = { key = c.key, pos = c.pos, text = txt, color = Color3.fromRGB(80, 170, 255) }
					end
				end
			end
		end
		D.acts, D.empties, D.emptyKeys, D.esp, D.n = acts, empties, emptyKeys, esp, n
	end

