		return ("%s\nPetak: %d | Belum ditanam: %d\nSiap panen/petik: %d | Tumbuh: %d | Tebang: %d"):format(
			status, #Ps, n.kosong, n.siap, n.tumbuh, n.tebang)
	end
	function M.CariUlang() S.Force = nil reload() end
	function M.PetakTerdekat()
		local all = {}
		for _, f in ipairs(workspace:GetDescendants()) do
			if f.Name == "TaniSel" and f:IsA("Folder") then
				local pt = f.Parent
				local area = pt and pt:FindFirstChild("Area")
				if area and area:IsA("BasePart") then all[#all + 1] = { pt = pt, area = area } end
			end
		end
		local n = nearestPetak(all)
		if n then S.Force = n.pt reload() end
	end
	function M.SetMargin(v)
		S.Margin = math.clamp(v, 0, 0.25)
		for _, P in ipairs(Ps) do P.off = Vector3.zero end
		mark()
	end
	function M.ResetMemori()
		gen += 1
		table.clear(soil) table.clear(failUntil) table.clear(cool) table.clear(fails)
		mark()
	end
	function M.Dump() dumpPrompts() end
	function M.SetBibit(n)
		if S.Bibit == n then return end
		gen += 1
		S.Bibit = n
		table.clear(failUntil) table.clear(cool) table.clear(fails)
		tillUntil = 0
		hoeInfo.jadi, hoeInfo.gembur, hoeInfo.rata = nil, nil, nil
		for _, s in pairs(soil) do s.hits, s.tries = 0, 0 end
		mark()
	end
	function M.Mark() mark() end
	return M
end

