	local function onT(sig, fn) local c = sig:Connect(fn) table.insert(conns, c) return c end

	local function root() local c = LP.Character return c and c:FindFirstChild("HumanoidRootPart") end
	local function hum() local c = LP.Character return c and c:FindFirstChildOfClass("Humanoid") end
	local function bawa() return LP:GetAttribute("BawaRumput") or 0 end
	local function tumpukan() local p = LP:GetAttribute("TumpukanPos") return typeof(p) == "Vector3" and p or nil end
	local function posOf(i)
		if not i then return end
		if i:IsA("BasePart") then return i.Position end
		if i:IsA("Attachment") then return i.WorldPosition end
		if i:IsA("Model") then return i:GetPivot().Position end
	end

	---------------------------------------------------------------- TELEPORT
	local function tp(pos)
		local r = root()
		if not r then return end
		local target = pos + Vector3.new(0, 3, 0)
		while S.ALIVE and (r.Position - target).Magnitude > S.HOP do
			r.CFrame = CFrame.new(r.Position + (target - r.Position).Unit * S.HOP)
			task.wait(S.TUNGGU)
		end
		r.CFrame = CFrame.new(target)
		task.wait(S.TUNGGU)
	end

	---------------------------------------------------------------- LAHAN, LUMBUNG, KANDANG
	local lahanCache
	local function myLahan()
		if lahanCache and lahanCache.Parent then return lahanCache end
		local lobby = workspace:FindFirstChild("Lobby")
		local lahan = lobby and lobby:FindFirstChild("Lahan")
		if lahan then
			for _, c in ipairs(lahan:GetChildren()) do
				if c:GetAttribute("OwnerUserId") == LP.UserId then lahanCache = c return c end
			end
		end
	end

	local function kebun()
		local l = myLahan()
		return l and l:FindFirstChild("Kebun")
	end

	local function lumbung()
		local k = kebun()
		return k and k:FindFirstChild("LumbungSuket")
	end

	local function stokLumbung()
		local lb = lumbung()
		if not lb then return nil end
		local paj = lb:FindFirstChild("Pajangan")
		if not paj then
			for _, v in pairs(lb:GetAttributes()) do
				if type(v) == "number" then return math.min(v, S.KAP) end
			end
			return 0
		end
		local total = 0
		for _, d in ipairs(paj:GetChildren()) do
			if d.Name:lower():find("gulungan") then
				local amt
				for k, v in pairs(d:GetAttributes()) do
					local n = k:lower()
					if type(v) == "number" and (n:find("isi") or n:find("jumlah") or n:find("sabet") or n:find("stok") or n:find("amount")) then
						amt = v break
					end
				end
				total += math.clamp(amt or S.PER_SLOT, 0, S.PER_SLOT)
			end
		end
		return math.min(total, S.KAP)
	end

	local function slotPrompts()
		local lb = lumbung()
		local list = {}
		if not lb then return list end
		for _, d in ipairs(lb:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Name == "PromptStok" then table.insert(list, d) end
		end
		return list
	end

	local function firePrompt(pr)
		if not (pr and fireproximityprompt) then return false end
		pcall(fireproximityprompt, pr)
		pcall(function() pr:InputHoldBegin() task.wait(pr.HoldDuration + 0.1) pr:InputHoldEnd() end)
		return true
	end

	---------------------------------------------------------------- PAKAN (PALUNGAN)
	local function pakanPrompts()
		local k = kebun()
		local kd = k and k:FindFirstChild("Kandang")
		local list = {}
		if not kd then return list end
		for _, d in ipairs(kd:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Name == "PromptTuang" then table.insert(list, d) end
		end
		return list
	end

	local KW = { "isi", "pakan", "penuh", "persen", "percent", "level", "stok", "stock", "fill", "rumput", "kenyang" }
	local function normAttr(inst, v)
		for k, w in pairs(inst:GetAttributes()) do
			if type(w) == "number" then
				local n = k:lower()
				if (n:find("maks") or n:find("max") or n:find("kapasitas")) and w > 0 then return v / w * 100 end
			end
		end
		if v <= 1 then return v * 100 end
		return v
	end

	local function scanAttr(inst)
		for k, v in pairs(inst:GetAttributes()) do
			if type(v) == "number" then
				local n = k:lower()
				if not (n:find("owner") or n:find("userid") or n:find("maks") or n:find("max") or n:find("kapasitas")) then
					for _, w in ipairs(KW) do
						if n:find(w) then return normAttr(inst, v), inst.Name .. "." .. k end
					end
				end
			end
		end
	end

	local function pctOfPrompt(pr)
		local part = pr.Parent
		local palungan = part and part.Parent
		for _, inst in ipairs({ part, palungan }) do
			if inst then
				local v, src = scanAttr(inst)
				if v then return v, src end
			end
		end
		if part then
			for _, d in ipairs(part:GetDescendants()) do
				local v, src = scanAttr(d)
				if v then return v, src end
			end
		end
		if palungan then
			for _, d in ipairs(palungan:GetDescendants()) do
				if d:IsA("TextLabel") or d:IsA("TextBox") then
					local n = tostring(d.Text):match("(%d+%.?%d*)%s*%%")
					if n then return tonumber(n), d:GetFullName() end
				end
			end
		end
	end

	local lastPakanSrc = "-"
	local function pakanPersen()
		local low, src
		for _, pr in ipairs(pakanPrompts()) do
			local v, s = pctOfPrompt(pr)
			if v and (not low or v < low) then low, src = v, s end
		end
		if src then lastPakanSrc = src end
		return low
	end

	---------------------------------------------------------------- TERNAK LAPAR (cadangan)
	local function ternakLapar()
		local list = {}
		for _, p in ipairs(TernakProxy:GetChildren()) do
			if p:IsA("BasePart") and p:GetAttribute("Owner") == LP.UserId
				and Cfg.jenis(p:GetAttribute("Jenis")).pakan ~= "daging"
				and (p:GetAttribute("Kenyang") or 100) < S.BATAS_LAPAR
				and not p:GetAttribute("Penunggang") then
				table.insert(list, p)
			end
		end
		table.sort(list, function(a, b) return (a:GetAttribute("Kenyang") or 0) < (b:GetAttribute("Kenyang") or 0) end)
		return list
	end

	---------------------------------------------------------------- PROMPT UMUM + REMOTE PASIF
	local function promptNear(pos, radius, patterns)
		local best, bd
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Enabled and d.Name ~= "PromptStok" then
				local pp = posOf(d.Parent)
				if pp and (pp - pos).Magnitude <= radius then
					local txt = (d.ActionText .. " " .. d.ObjectText .. " " .. d.Parent.Name):lower()
					local ok = false
					for _, p in ipairs(patterns) do if txt:find(p) then ok = true end end
					if ok and (not bd or (pp - pos).Magnitude < bd) then best, bd = d, (pp - pos).Magnitude end
				end
			end
		end
		return best
	end

	if hookmetamethod and getnamecallmethod then
		local old
		old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
			if S.ALIVE and not (checkcaller and checkcaller()) then
				local m = getnamecallmethod()
				if (m == "FireServer" or m == "InvokeServer") and typeof(self) == "Instance" and self.Parent == Remotes then
					local args = table.pack(...)
					local hasProxy = false
					for i = 1, args.n do
						if typeof(args[i]) == "Instance" and args[i].Parent == TernakProxy then hasProxy = true end
					end
					local key
					if self.Name == "Ternak_Aksi" then
						if hasProxy and bawa() > 0 then key = "TUANG"
						elseif not hasProxy and tumpukan() then key = "ANGKAT" end
					end
					if key then S.TPL[key] = { remote = self, method = m, args = args } end
				end
			end
			return old(self, ...)
		end))
	end

	local function replay(nama, proxy, pos)
		local t = S.TPL[nama]
		if not t then return false end
		local a = table.clone(t.args)
		for i = 1, t.args.n do
			local v = a[i]
			if typeof(v) == "Instance" and v.Parent == TernakProxy and proxy then a[i] = proxy
			elseif typeof(v) == "Vector3" and pos then a[i] = pos
			elseif typeof(v) == "CFrame" and pos then a[i] = CFrame.new(pos) end
		end
		task.spawn(function()
			pcall(function()
				if t.method == "FireServer" then t.remote:FireServer(table.unpack(a, 1, t.args.n))
				else t.remote:InvokeServer(table.unpack(a, 1, t.args.n)) end
			end)
		end)
		return true
	end

	---------------------------------------------------------------- DETEKSI PESAN GAME
	local labels = setmetatable({}, { __mode = "k" })
	local function isHabisText(t) return type(t) == "string" and t:lower():find("sudah habis diarit") ~= nil end
	local function isPasText(t) return type(t) == "string" and t:lower():find("tumpukan sudah pas") ~= nil end

	local function cek(inst)
		if isHabisText(inst.Text) then S.HABIS_T = os.clock() end
		if isPasText(inst.Text) then S.PAS_T = os.clock() end
	end

	local function watch(inst)
		if not inst:IsA("TextLabel") then return end
		labels[inst] = true
		cek(inst)
		onT(inst:GetPropertyChangedSignal("Text"), function() cek(inst) end)
	end
	for _, d in ipairs(PG:GetDescendants()) do watch(d) end
	onT(PG.DescendantAdded, watch)

	local function habisAktif()
		if os.clock() - S.HABIS_T < 1.2 then return true end
		for l in pairs(labels) do
			if l.Parent and l.Visible and l.TextTransparency < 0.9 and isHabisText(l.Text) then
				local sg = l:FindFirstAncestorOfClass("ScreenGui")
				if not sg or sg.Enabled then return true end
			end
		end
		return false
	end

	local function pasAktif()
		if os.clock() - S.PAS_T < 2.5 then return true end
		for l in pairs(labels) do
			if l.Parent and l.Visible and l.TextTransparency < 0.9 and isPasText(l.Text) then
				local sg = l:FindFirstAncestorOfClass("ScreenGui")
				if not sg or sg.Enabled then return true end
			end
		end
		return false
	end

	onT(Ternak_Arit.OnClientEvent, function(aksi, p1, p2)
		if aksi == "terpotong" then
			local pemain = (typeof(p2) == "Instance" and p2) or LP
			if pemain == LP then S.CUT += 1 end
		end
	end)

	local function tandaiHabis(pos) table.insert(S.HABISLIST, { pos = pos, t = os.clock() }) end

	local function sudahHabis(pos)
		local now = os.clock()
		for i = #S.HABISLIST, 1, -1 do
			local e = S.HABISLIST[i]
			if now - e.t > S.HABIS_TTL then
				table.remove(S.HABISLIST, i)
			elseif (Vector3.new(e.pos.X, 0, e.pos.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude < S.JARAK_HABIS then
				return true
			end
		end
		return false
	end

	---------------------------------------------------------------- AUTO-WIN MINIGAME ANGKAT
	local function guiParts()
		local g = PG:FindFirstChild("AngkatRumputGui")
		if not (g and g.Enabled) then return end
		local panel = g:FindFirstChild("Panel")
		local bar = panel and panel:FindFirstChild("Bar")
		return g, bar and bar:FindFirstChild("Isi"), bar and bar:FindFirstChild("Berat"), g:FindFirstChild("Tombol")
	end

	local function pressClick()
		local vs = workspace.CurrentCamera.ViewportSize
		local x, y = vs.X * 0.5, vs.Y * 0.2
		VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
		task.wait(0.01)
		VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end

	local function pressSpace()
		VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
		task.wait(0.01)
		VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
	end

	local function pressButton(btn)
		if not (btn and btn.Visible and getconnections) then return pressClick() end
		for _, c in ipairs(getconnections(btn.Activated)) do pcall(function() c:Fire() end) end
		for _, c in ipairs(getconnections(btn.MouseButton1Click)) do pcall(function() c:Fire() end) end
	end

	task.spawn(function()
		local method, count, windowStart = 1, 0, 0
		while S.ALIVE do
			local g, isi, zona, btn = guiParts()
			if S.AUTO and g and isi then
				local fill = isi.Size.X.Scale
				if count == 0 then windowStart = fill end

				if method == 1 then pressClick()
				elseif method == 2 then pressSpace()
				else pressButton(btn) end
				count += 1

				if count >= 8 then
					if isi.Size.X.Scale < windowStart + 0.02 then
						method = method % 3 + 1
						S.STATUS = "minigame: ganti metode " .. method
					end
					count = 0
				end

				local inZone = false
				if zona then
					local zs, ze = zona.Position.X.Scale, zona.Position.X.Scale + zona.Size.X.Scale
					inZone = fill >= zs - 0.03 and fill <= ze
				end
				task.wait(inZone and (0.055 + math.random() * 0.02) or (0.085 + math.random() * 0.03))
			else
				count = 0
				task.wait(0.1)
			end
		end
	end)

	---------------------------------------------------------------- NGARIT
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Include
	rayParams.FilterDescendantsInstances = { Terrain }

	local function grassAt(origin, minR, maxR, tries)
		for _ = 1, tries do
			local a, r = math.random() * math.pi * 2, minR + math.random() * (maxR - minR)
			local from = Vector3.new(origin.X + math.cos(a) * r, origin.Y + 500, origin.Z + math.sin(a) * r)
			local hit = workspace:Raycast(from, Vector3.new(0, -1500, 0), rayParams)
			if hit and hit.Material == Enum.Material.Grass and not sudahHabis(hit.Position) then
				return hit.Position
			end
		end
	end

	local function cariRumput()
		local l = myLahan()
		local pile = tumpukan()
		local base = pile or S.LASTPOS

		if base then
			local p = grassAt(base, S.GESER_MIN, S.GESER_MAKS, 80)
			if p then return p end
			if pile then S.STUCK = true return end
		end

		local origins = {}
		if root() then table.insert(origins, root().Position) end
		if l and posOf(l) then table.insert(origins, posOf(l)) end

		for pass = 1, 2 do
			for _, r in ipairs({ 18, 40, 80, 140, 250 }) do
				for _, o in ipairs(origins) do
					local p = grassAt(o, 0, r, 40)
					if p then return p end
				end
			end
			if pass == 1 then table.clear(S.HABISLIST) end
		end
	end

	local function equipArit()
		local h = hum()
		if not h then return end
		local function find(c)
			if not c then return end
			for _, t in ipairs(c:GetChildren()) do
				if t:IsA("Tool") and (t.Name:find("Arit") or t:GetAttribute("Sabit")) then return t end
			end
		end
		local tool = find(LP.Character) or find(LP.Backpack)
		if tool and tool.Parent ~= LP.Character then h:EquipTool(tool) task.wait(0.2) end
		return tool
	end

	local function ngarit()
		if S.CUT == 0 then
			S.LIMIT = math.clamp(S.KAP - (stokLumbung() or 0), 1, S.MAKS_GULUNGAN)
		end
		while S.ALIVE and S.AUTO and S.CUT < S.LIMIT and bawa() <= 0 and not S.STUCK do
			S.STATUS = ("ngarit %d/%d (stok %s)"):format(S.CUT, S.LIMIT, tostring(stokLumbung()))
			local pos = cariRumput()
			if not pos then
				if not S.STUCK then S.STATUS = "Terrain Grass tidak ketemu (coba pindah dekat rumput)" task.wait(2) end
				return
			end
			tp(pos)
			S.LASTPOS = pos
			S.HABIS_T = 0
			task.wait(0.6)
			if not equipArit() then S.STATUS = "Arit tidak ada" return end

			local habis = false
			for _ = 1, Cfg.ARIT.SABET_MAKS do
				if not (S.ALIVE and S.AUTO) then return end
				if S.CUT >= S.LIMIT then return end
				Ternak_Arit:FireServer("sabet")
				task.wait(Cfg.ARIT.JEDA + 0.05)
				if pasAktif() then
					S.STUCK = true
					S.STATUS = "tumpukan pas -> angkat"
					return
				end
				if habisAktif() then
					tandaiHabis(pos)
					S.STATUS = "rumput habis -> geser"
					habis = true
					break
				end
				S.STATUS = ("ngarit %d/%d (stok %s)"):format(S.CUT, S.LIMIT, tostring(stokLumbung()))
			end
			if not habis then tandaiHabis(pos) end
		end
	end

	local function angkat()
		S.STATUS = "angkat tumpukan"
		local p = tumpukan()
		if not p then return end
		tp(p)
		local pr = promptNear(p, 15, { "angkat", "rumput", "tumpuk", "ambil" })
		if not firePrompt(pr) then replay("ANGKAT", nil, p) end
		task.wait(0.3)
		local g = PG:FindFirstChild("AngkatRumputGui")
		if bawa() <= 0 and not (g and g.Enabled) then
			pcall(function()
				VIM:SendKeyEvent(true, Enum.KeyCode.F, false, game)
				task.wait(0.1)
				VIM:SendKeyEvent(false, Enum.KeyCode.F, false, game)
			end)
		end
		local t = os.clock()
		while S.ALIVE and S.AUTO and bawa() <= 0 and os.clock() - t < 25 do
			task.wait(0.15)
		end
		S.CUT, S.STUCK, S.LASTPOS, S.PAS_T = 0, false, nil, 0
	end

	local function kumpulRumput()
		if not tumpukan() then S.CUT = 0 S.STUCK = false end
		if tumpukan() and (S.CUT >= S.LIMIT or S.STUCK) then
			angkat()
		else
			ngarit()
			if tumpukan() and (S.CUT >= S.LIMIT or S.STUCK) then angkat() end
		end
	end

	---------------------------------------------------------------- LUMBUNG
	local function pakaiSlot()
		for _, pr in ipairs(slotPrompts()) do
			if pr.Enabled then
				local pos = posOf(pr.Parent)
				if pos then
					tp(pos)
					local before, bBawa = stokLumbung(), bawa()
					firePrompt(pr)
					task.wait(0.8)
					if bawa() ~= bBawa or stokLumbung() ~= before then return true end
				end
			end
		end
		return false
	end

	local function simpan() S.STATUS = "simpan ke lumbung" return pakaiSlot() end
	local function ambilDariLumbung() S.STATUS = "ambil stok lumbung" return pakaiSlot() end

	local function beriMakan(proxy)
		S.STATUS = "kasih makan " .. tostring(proxy:GetAttribute("Nama"))
		tp(proxy.Position)
		local pr = promptNear(proxy.Position, 12, { "tuang", "beri", "makan", "kasih", "rumput" })
		if not firePrompt(pr) then replay("TUANG", proxy, proxy.Position) end
		task.wait(0.7)
	end

	---------------------------------------------------------------- ISI PAKAN (palungan)
	local function isiPakan()
		local prs = pakanPrompts()
		if #prs == 0 then S.STATUS = "PromptTuang tidak ketemu" S.PAKAN_MODE = false return end

		if bawa() <= 0 then
			local stok = stokLumbung() or 0
			if stok >= 1 and ambilDariLumbung() then return end
			kumpulRumput()
			return
		end

		local target
		for _, pr in ipairs(prs) do
			if pr.Enabled then target = pr break end
		end
		target = target or prs[1]
		local pos = posOf(target.Parent)
		if not pos then return end

		local before, bBawa = pakanPersen(), bawa()
		S.STATUS = ("isi pakan (%s%%)"):format(before and tostring(math.floor(before)) or "?")
		tp(pos)
		firePrompt(target)
		task.wait(0.9)

		local after = pakanPersen()
		local berubah = (after and before and after > before + 0.3) or bawa() ~= bBawa
		if berubah then
			S.PAKAN_FAIL = 0
		else
			S.PAKAN_FAIL += 1
			if S.PAKAN_FAIL >= 4 then
				S.PAKAN_FAIL, S.PAKAN_MODE = 0, false
				S.PAKAN_HOLD = os.clock() + 60
				S.STATUS = "tuang pakan gagal, jeda 60 dtk"
			end
		end
	end

	---------------------------------------------------------------- LOOP UTAMA
	task.spawn(function()
		while S.ALIVE do
			task.wait(0.3)
			if S.AUTO then
				local ok, err = pcall(function()
					if not myLahan() then S.STATUS = "lahan tidak ketemu" return end
					local stok = stokLumbung() or 0
					local pk = pakanPersen()

					if pk then
						if pk <= S.PAKAN_MIN and os.clock() > S.PAKAN_HOLD then S.PAKAN_MODE = true
						elseif pk >= S.PAKAN_TARGET then S.PAKAN_MODE = false end
					end

					local lapar = pk == nil and ternakLapar() or {}
					local selesai = not S.PAKAN_MODE and bawa() <= 0 and #lapar == 0 and stok >= S.STOK_TARGET

					if not selesai and not S.ASAL and root() then S.ASAL = root().Position end
					if selesai then
						if S.KEMBALI and S.ASAL then
							S.STATUS = "selesai -> kembali ke lokasi awal"
							local p = S.ASAL
							S.ASAL = nil
							tp(p)
						end
						S.ASAL = nil
						S.STATUS = "idle (stok 72/72, pakan aman)"
						return
					end

					if S.PAKAN_MODE then
						isiPakan()
						return
					end

					if bawa() > 0 then
						if #lapar > 0 and stok >= S.STOK_MIN then
							beriMakan(lapar[1])
						elseif stok >= S.KAP then
							S.STATUS = "lumbung penuh 72/72"
							if #lapar > 0 then beriMakan(lapar[1]) end
						elseif not simpan() then
							S.STATUS = "slot penuh/prompt gagal"
							if #lapar > 0 then beriMakan(lapar[1]) end
						end
					elseif stok < S.STOK_MIN then
						kumpulRumput()
					elseif #lapar > 0 then
						if not ambilDariLumbung() then kumpulRumput() end
					elseif stok < S.STOK_TARGET then
						kumpulRumput()
					else
						S.STATUS = "idle (stok 72/72, pakan aman)"
					end
				end)
				if not ok then warn("[AutoTernak] " .. tostring(err)) end
			end
		end
	end)

	---------------------------------------------------------------- API untuk UI
	local M = { S = S }
	function M.SetActive(v)
		S.AUTO = v and true or false
		if not S.AUTO then S.ASAL = nil end
	end
	function M.IsActive() return S.AUTO end
	function M.Kill()
		S.ALIVE, S.AUTO = false, false
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		table.clear(conns)
	end
	function M.Info()
		local stok, pk = stokLumbung(), pakanPersen()
		return ("Lahan: %s | Lumbung: %s\nStok: %s | Bawa: %d | Gulungan: %d/%d\nPakan: %s | Mode isi: %s\nTumpukan: %s | Titik habis: %d\nStatus: %s"):format(
			myLahan() and "OK" or "-", lumbung() and "OK" or "-",
			stok and (stok .. "/" .. S.KAP) or "?", bawa(), S.CUT, S.LIMIT,
			pk and (math.floor(pk) .. "%") or "?", S.PAKAN_MODE and "ON" or "-",
			tumpukan() and "ada" or "-", #S.HABISLIST, S.STATUS)
	end
	return M
end

