	-- ===== API untuk UI =====
	local M = { S = S, Seeds = Cfg.URUT_BIBIT or { "Bibit Padi", "Bibit Pisang" } }
	function M.SetActive(v) S.Aktif = v and true or false mark() end
	function M.IsActive() return S.Aktif end
