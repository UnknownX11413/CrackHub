	-- ===== aksi =====
	local function firePrompt(p)
		p.Enabled = true
		p.HoldDuration = 0
		p.RequiresLineOfSight = false
		if fireproximityprompt then
			pcall(fireproximityprompt, p)
		else
			pcall(function() p:InputHoldBegin() task.wait(0.05) p:InputHoldEnd() end)
		end
	end

	local function doPrompt(a)
		local p, cat = a.p, a.cat
		local r = hrp()
		local dir = unit(r.Position - a.pos, a.P.area.CFrame.RightVector)
		tpTo(a.pos + dir * 2.2, a.pos, a.top)
		task.wait(0.25)
		local now = os.clock()
		fails[p] = (fails[p] or 0) + 1
		if fails[p] > 6 then
			cool[p] = now + 60
			fails[p] = 0
		else
			cool[p] = now + (cat == "Goyang" and 14 or cat == "Siram" and 60 or 3)
		end
		firePrompt(p)
		task.wait(0.25)
		if cat == "Goyang" then
			local t0 = os.clock()
			while not goyangBusy and os.clock() - t0 < 2 do task.wait(0.05) end
			while goyangBusy and os.clock() - t0 < 15 do task.wait(0.1) end
		else
			task.wait((a.dur or 1) + 0.15)
			if cat ~= "Siram" and p.Parent and p:GetAttribute("Aktif") ~= false then
				pcall(function() p:InputHoldBegin() task.wait(0.1) p:InputHoldEnd() end)
				task.wait(0.4)
			else
				fails[p] = 0
			end
		end
	end

	-- ===== baca keterangan game =====
	local hoeInfo = { gembur = nil, jadi = nil, rata = nil }

	local function parseText(s)
		if type(s) ~= "string" or s == "" then return end
		local l = s:lower()
		if l:find("tanah gembur", 1, true) then hoeInfo.gembur = os.clock() end
		if l:find("gundukan jadi", 1, true) then hoeInfo.jadi = os.clock() end
		local a, b = l:match("meratakan gundukan%s*(%d+)%s*/%s*(%d+)")
		if a and tonumber(a) >= tonumber(b) then hoeInfo.rata = os.clock() end
		local nm, n = l:match("bibit%s+(%a+)%s+ditanam.-cangkul gundukan ini%s+(%d+)%s+kali")
		if nm and n and nm ~= "pisang" then
			HOE["Bibit " .. nm:sub(1, 1):upper() .. nm:sub(2)] = tonumber(n)
		end
	end

	local function watch(o)
		if o:IsA("TextLabel") or o:IsA("TextButton") then
			bind(o:GetPropertyChangedSignal("Text"), function() parseText(o.Text) end)
		end
	end

	task.spawn(function()
		for _, o in ipairs(PG:GetDescendants()) do watch(o) end
		bind(PG.DescendantAdded, function(o)
			watch(o)
			if o:IsA("TextLabel") or o:IsA("TextButton") then task.defer(parseText, o.Text) end
		end)
	end)

	bind(Aksi.OnClientEvent, function(...)
		for _, v in ipairs({ ... }) do
			if type(v) == "string" then
				parseText(v)
			elseif type(v) == "table" then
				for _, x in pairs(v) do if type(x) == "string" then parseText(x) end end
			end
		end
	end)

	-- ===== CANGKUL BERBASIS MEMORI SEL =====
	local function hoeCell(c, target, bibit)
		local s = getSoil(c.key)
		if s.stage == target then return true end
		if not (S.Cangkul and equip(Cfg.ALAT_CANGKUL)) then return false end
		local g = gen
		local startT = os.clock()
		local loops = 0
		if target == "gembur" then tillUntil = os.clock() + 99 end
		while S.Aktif and g == gen and loops < 8 and s.stage ~= target do
			status = ("Cangkul sel (%s, %dx)"):format(stageTxt[s.stage], s.hits + 1)
			Aksi:FireServer("cangkul")
			loops += 1
			s.hits += 1
			task.wait(Cfg.DURASI.Cangkul + 0.15)
			if hoeInfo.jadi and hoeInfo.jadi >= startT then
				hoeInfo.jadi = nil
				setStage(s, "gundukan")
			elseif hoeInfo.gembur and hoeInfo.gembur >= startT then
				hoeInfo.gembur = nil
				setStage(s, "gembur")
			elseif hoeInfo.rata and hoeInfo.rata >= startT then
				hoeInfo.rata = nil
				setStage(s, "rata")
			elseif target == "gembur" and s.stage == "rata" and s.hits >= hoeCount(bibit) then
				setStage(s, "gembur")
			end
			dirty = true
		end
		if target == "gembur" then
			tillUntil = os.clock() + 1.5
			task.wait(1.6)
		else
			tillUntil = 0
			task.wait(0.4)
		end
		if g ~= gen then return false end
		if s.stage ~= target then
			s.tries = (s.tries or 0) + 1
			if s.tries >= 2 then
				setStage(s, target)
				s.tries = 0
			end
		else
			s.tries = 0
		end
		dirty = true
		return s.stage == target
	end

	local function tryPlant(bibit)
		if bibit ~= S.Bibit then return nil end
		if not equip(bibit) then return nil end
		local g = gen
		local before, t0 = addTick, os.clock()
		Aksi:FireServer("tanam")
		while os.clock() - t0 < Cfg.DURASI.Tanam + 1.5 and addTick == before and S.Aktif and g == gen do task.wait(0.05) end
		local ok = addTick ~= before
		local rest = Cfg.DURASI.Tanam + 0.1 - (os.clock() - t0)
		if rest > 0 then task.wait(rest) end
		return ok
	end

	local function afterPlant(c, ok)
		if ok then
			soil[c.key] = nil
		else
			local s = getSoil(c.key)
			setStage(s, "rata")
			failUntil[c.key] = os.clock() + 10
		end
		dirty = true
		refresh()
	end

	local function moundCell(c, bibit)
		hoeCell(c, "gundukan", bibit)
	end

	local function seedCell(c, bibit)
		local g = gen
		curKey = c.key
		local ok = tryPlant(bibit)
		curKey = nil
		if g ~= gen or bibit ~= S.Bibit then return end
		if ok == nil then
			status = "Bibit habis: " .. bibit
			failUntil[c.key] = os.clock() + 5
			return
		end
		afterPlant(c, ok)
	end

	local function plantPadi(c, bibit)
		local g = gen
		if S.Cangkul and getSoil(c.key).stage ~= "gembur" then
			hoeCell(c, "gembur", bibit)
			if g ~= gen then return end
		end
		curKey = c.key
		local ok = tryPlant(bibit)
		curKey = nil
		if g ~= gen or bibit ~= S.Bibit then return end
		if ok == nil then
			status = "Bibit habis: " .. bibit
			failUntil[c.key] = os.clock() + 5
			return
		end
		afterPlant(c, ok)
	end

	local function plantAt(c, phase)
		local bibit = S.Bibit
		local g = gen
		local look = unit(c.P.area.CFrame.LookVector, Vector3.new(0, 0, -1))
		tpTo(c.pos - look * DEPAN, c.pos, c.top)
		task.wait(0.3)
		if g ~= gen then return end
		if legacy(bibit) then
			if phase == "cangkul" then moundCell(c, bibit) else seedCell(c, bibit) end
		else
			plantPadi(c, bibit)
		end
	end

	local function nearestEmpty(r, now, pred)
		local bc, bd
		for _, c in ipairs(D.empties) do
			if (failUntil[c.key] or 0) < now and pred(c) then
				local d = d2(c.pos, r.Position)
				if not bd or d < bd then bc, bd = c, d end
			end
		end
		return bc
	end

	local function step()
		local r = hrp()
		local now = os.clock()
		local best, bd
		for _, a in ipairs(D.acts) do
			local p = a.p
			if p.Parent and S[a.cat] and p:GetAttribute("Aktif") ~= false and (cool[p] or 0) < now then
				local d = (a.pos - r.Position).Magnitude + (a.cat == "Siram" and 1000 or 0)
				if not bd or d < bd then best, bd = a, d end
			end
		end
		if best then
			status = "Aksi: " .. best.cat
			doPrompt(best)
			return true
		end

		if legacy(S.Bibit) then
			if S.Cangkul then
				local c = nearestEmpty(r, now, function(c) return getSoil(c.key).stage ~= "gundukan" end)
				if c then
					status = "Fase 1: Cangkul"
					plantAt(c, "cangkul")
					return true
				end
			end
			if S.Tanam then
				local c = nearestEmpty(r, now, function(c) return getSoil(c.key).stage == "gundukan" or not S.Cangkul end)
				if c then
					if not findTool(S.Bibit) then
						status = "Bibit habis: " .. S.Bibit
						return false
					end
					status = "Fase 2: Tanam"
					plantAt(c, "tanam")
					return true
				end
			end
		elseif S.Tanam then
			local c = nearestEmpty(r, now, function() return true end)
			if c then
				if not findTool(S.Bibit) then
					status = "Bibit habis: " .. S.Bibit
					return false
				end
				status = "Menanam (" .. S.Bibit .. ")"
				plantAt(c)
				return true
			end
		end
		status = (#Ps == 0) and status or "Semua penuh, menunggu update"
		return false
	end

	task.spawn(function()
		reload()
		local last = os.clock()
		while S.Run do
			if os.clock() - last > 2 then dirty = true last = os.clock() end
			refresh()
			if S.Aktif and alive() and not goyangBusy and #Ps > 0 then
				local ok, res = pcall(step)
				if not ok then
					warn("[AutoTani]", res)
					task.wait(1)
				elseif res then
					dirty = true
				else
					task.wait(0.25)
				end
			else
				task.wait(0.25)
			end
			task.wait()
		end
	end)

