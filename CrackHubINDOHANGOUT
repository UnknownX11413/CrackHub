-- MODUL: CRYSTAL MINER
--====================================================================
local function ModMining()
	local map = workspace:WaitForChild("MapContent", 5)
	local Crystals = map and map:WaitForChild("Crystals", 5)
	if not Crystals then return nil, "workspace.MapContent.Crystals tidak ditemukan" end

	local S = {
		Auto = false,
		ESP = true,
		Move = "Jalan",
		Speed = "Normal",
		DelayNormal = 0.2,
		DelayFast = 0.1,
		Range = 2.8,
		Approach = 2.2,
		MaxWalk = 600,
		FailSwings = 40,
		SkipTime = 8,
	}

	local blacklist, status = {}, "idle"
	local swings, drops, skipped, since = 0, 0, 0, 0
	local okMax, failMin, curDist = 0, math.huge, nil

	local function hrp() local c = lp.Character return c and c:FindFirstChild("HumanoidRootPart") end
	local function posOf(i)
		if i:IsA("BasePart") then return i.Position end
		if i:IsA("Model") then return i:GetPivot().Position end
	end
	local function surfaceDist(c, pos)
		local cf, size
		if c:IsA("BasePart") then cf, size = c.CFrame, c.Size else cf, size = c:GetBoundingBox() end
		local rel, h = cf:PointToObjectSpace(pos), size / 2
		local cl = Vector3.new(math.clamp(rel.X, -h.X, h.X), math.clamp(rel.Y, -h.Y, h.Y), math.clamp(rel.Z, -h.Z, h.Z))
		return (pos - cf:PointToWorldSpace(cl)).Magnitude
	end
	local function isSkipped(c) return blacklist[c] and blacklist[c] > os.clock() end
	local function swingDelay() return S.Speed == "Cepat" and S.DelayFast or S.DelayNormal end

	local function getPickaxe()
		local c = lp.Character
		if not c then return end
		for _, t in ipairs(c:GetChildren()) do
			if t:IsA("Tool") and t.Name:lower():find("pickaxe", 1, true) then return t end
		end
		local bpk = lp:FindFirstChildOfClass("Backpack")
		if bpk then
			for _, t in ipairs(bpk:GetChildren()) do
				if t:IsA("Tool") and t.Name:lower():find("pickaxe", 1, true) then
					local h = c:FindFirstChildOfClass("Humanoid")
					if h then h:EquipTool(t) end
					task.wait(0.2)
					return t
				end
			end
		end
	end

	local function pick(root)
		local stay = S.Move == "Diam"
		local best, bd, inR = nil, nil, 0
		for _, c in ipairs(Crystals:GetChildren()) do
			local d = surfaceDist(c, root.Position)
			if (stay and d <= S.Range) or (not stay and d <= S.MaxWalk) then
				inR += 1
				if not isSkipped(c) and (not bd or d < bd) then best, bd = c, d end
			end
		end
		if not best and inR > 0 then table.clear(blacklist) end
		return best, bd
	end

	local function onDrop(name)
		if not name:lower():find("crystal", 1, true) then return end
		drops += 1
		since = 0
		if curDist then okMax = math.max(okMax, curDist) end
	end
	local bp = lp:WaitForChild("Backpack")
	local function watchItem(it) C(it:GetPropertyChangedSignal("Name"), function() onDrop(it.Name) end) end
	for _, it in ipairs(bp:GetChildren()) do watchItem(it) end
	C(bp.ChildAdded, function(it) watchItem(it); onDrop(it.Name) end)

	local function standCFrame(root, target)
		local p = posOf(target)
		if not p then return end
		local dir = (root.Position - p) * Vector3.new(1, 0, 1)
		if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
		local stand = p + dir.Unit * math.max(S.Approach + 1, 2)
		local pos = Vector3.new(stand.X, root.Position.Y, stand.Z)
		return CFrame.lookAt(pos, Vector3.new(p.X, root.Position.Y, p.Z))
	end

	local function mine()
		local token = {}
		env.__CM_TOKEN = token
		local tgt
		while S.Auto and env.__CM_TOKEN == token do
			local root = hrp()
			local tool = root and getPickaxe()
			if not tool then
				status = root and "pickaxe tidak ada" or "karakter tidak ada"
				task.wait(0.5)
				continue
			end
			local target, d = pick(root)
			if not target then
				status = S.Move == "Diam" and "tidak ada crystal di range" or "tidak ada crystal"
				task.wait(0.4)
				continue
			end
			if target ~= tgt then tgt, since = target, 0 end
			curDist = d

			if S.Move ~= "Diam" then
				local hum = lp.Character:FindFirstChildOfClass("Humanoid")
				local p = posOf(target)
				if hum and p then
					if d > S.Approach + 0.4 then
						if S.Move == "Teleport" then
							local cf = standCFrame(root, target)
							if cf then
								root.CFrame = cf
								root.AssemblyLinearVelocity = Vector3.zero
							end
							status = string.format("teleport ke crystal %.1f", d)
							task.wait(0.15)
						else
							local dir = (root.Position - p) * Vector3.new(1, 0, 1)
							if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
							hum:MoveTo(p + dir.Unit * math.max(S.Approach, 1))
							status = string.format("jalan ke crystal %.1f", d)
							local t0 = os.clock()
							while S.Auto and target.Parent and os.clock() - t0 < 1.5 do
								local r2 = hrp()
								if not r2 or surfaceDist(target, r2.Position) <= S.Approach + 0.4 then break end
								if hum.MoveDirection.Magnitude < 0.05 then hum.Jump = true end
								task.wait(0.1)
							end
						end
						continue
					end
					hum:MoveTo(root.Position)
					root.CFrame = CFrame.lookAt(root.Position, Vector3.new(p.X, root.Position.Y, p.Z))
				end
			end

			pcall(function() tool:Activate() end)
			swings += 1
			since += 1
			status = string.format("mine %.1f studs (%d/%d) [%s]", d, since, S.FailSwings, S.Speed)
			task.wait(swingDelay())

			if since >= S.FailSwings then
				blacklist[target] = os.clock() + S.SkipTime
				failMin = math.min(failMin, d)
				skipped += 1
				since, tgt = 0, nil
			end
		end
		status = "idle"
	end

	-- ESP
	local espObjs = {}
	local function addESP(c)
		if espObjs[c] then return end
		local adornee = c:IsA("BasePart") and c or (c.PrimaryPart or c:FindFirstChildWhichIsA("BasePart", true))
		if not adornee then return end
		local hl = Instance.new("Highlight")
		hl.Adornee = c
		hl.FillTransparency = 0.6
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = gui
		local bb = Instance.new("BillboardGui")
		bb.Adornee = adornee
		bb.Size = UDim2.fromOffset(120, 30)
		bb.StudsOffset = Vector3.new(0, 3, 0)
		bb.AlwaysOnTop = true
		bb.Parent = gui
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.TextStrokeTransparency = 0
		tl.Font = Enum.Font.GothamBold
		tl.TextSize = 12
		tl.Parent = bb
		espObjs[c] = { hl = hl, bb = bb, tl = tl }
	end
	local function removeESP(c)
		local o = espObjs[c]
		if o then o.hl:Destroy() o.bb:Destroy() espObjs[c] = nil end
	end
	for _, c in ipairs(Crystals:GetChildren()) do addESP(c) end
	C(Crystals.ChildAdded, function(c) task.wait() addESP(c) end)
	C(Crystals.ChildRemoved, removeESP)

	local acc = 0
	C(RunService.Heartbeat, function(dt)
		acc += dt
		if acc < 0.2 then return end
		acc = 0
		local root = hrp()
		for c, o in pairs(espObjs) do
			if not c.Parent then removeESP(c)
			else
				o.hl.Enabled = S.ESP
				o.bb.Enabled = S.ESP
				if S.ESP then
					local d = root and surfaceDist(c, root.Position) or 0
					local sk = isSkipped(c)
					local col = sk and Color3.fromRGB(255, 150, 40)
						or (d <= S.Range and Color3.fromRGB(90, 255, 120) or Color3.fromRGB(90, 220, 255))
					o.hl.FillColor, o.hl.OutlineColor, o.tl.TextColor3 = col, col, col
					o.tl.Text = string.format("%s [%.1f]%s", c.Name, d, sk and " SKIP" or "")
				end
			end
		end
	end)

	local M = { S = S }
	function M.SetActive(v)
		v = v and true or false
		if v == S.Auto then return end
		S.Auto = v
		if v then task.spawn(mine) else env.__CM_TOKEN = nil end
	end
	function M.IsActive() return S.Auto end
	function M.Info()
		return string.format("%s\nswing: %d | drop: %d | skip: %d\nok max: %.1f | fail min: %s",
			status, swings, drops, skipped, okMax, failMin == math.huge and "-" or string.format("%.1f", failMin))
	end
	function M.Kill()
		S.Auto = false
		for c in pairs(espObjs) do removeESP(c) end
	end
	return M
end

--====================================================================
-- MODUL: AUTO FISHING (Rod / Reeling)
--====================================================================
local function ModFishing()
	local ev = RS:WaitForChild("Events", 5)
	local re = ev and ev:WaitForChild("RemoteEvent", 5)
	local Rod = re and re:WaitForChild("Rod", 5)
	if not Rod then return nil, "ReplicatedStorage.Events.RemoteEvent.Rod tidak ditemukan" end

	local S = { enabled = false, reeling = false, nextCast = 0, session = 0 }
	local alive = true

	local function getRod()
		local char = lp.Character
		if not char then return end
		for _, t in ipairs(char:GetChildren()) do
			if t:IsA("Tool") and t.Name:find("Rod") then return t end
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		for _, t in ipairs(lp.Backpack:GetChildren()) do
			if t:IsA("Tool") and t.Name:find("Rod") then
				if hum then hum:EquipTool(t) task.wait(0.3) end
				return t
			end
		end
	end

	local function cast()
		local rod = getRod()
		if not rod then return end
		pcall(function() rod:Activate() end)
		S.nextCast = os.clock() + 30
	end

	local function refs()
		local g = PG:FindFirstChild("Reeling")
		if not g then return end
		local mf = g:FindFirstChild("MainFrame")
		if not mf then return end
		local fr = mf:FindFirstChild("Frame")
		return g, mf, fr and fr:FindFirstChild("WhiteBar")
	end

	local function reelingOpen()
		local g, mf = refs()
		return g ~= nil and mf ~= nil and g.Enabled and mf.Visible
	end

	local function widen()
		local _, _, white = refs()
		if not white then return end
		pcall(function()
			white.Size = UDim2.new(1, 0, 1, 0)
			white.Position = UDim2.new(white.AnchorPoint.X, 0, white.Position.Y.Scale, white.Position.Y.Offset)
		end)
	end

	local function finish()
		S.reeling = false
		S.nextCast = os.clock() + 1.5
	end

	local function handleReel(session)
		local function ok() return alive and S.enabled and session == S.session end

		local t0 = os.clock()
		while not reelingOpen() and os.clock() - t0 < 2 do task.wait(0.05) end

		local c1 = RunService.Heartbeat:Connect(widen)
		local c2 = RunService.RenderStepped:Connect(widen)

		local startT = os.clock()
		while ok() and reelingOpen() and os.clock() - startT < 45 do task.wait(0.1) end

		c1:Disconnect()
		c2:Disconnect()
		task.wait(0.3)
		finish()
	end

	C(Rod.OnClientEvent, function(action)
		if action == "StartReeling" and S.enabled and not S.reeling then
			S.reeling = true
			S.session += 1
			task.spawn(handleReel, S.session)
		end
	end)

	task.spawn(function()
		while alive do
			task.wait(0.25)
			if S.enabled and not S.reeling and os.clock() >= S.nextCast then
				cast()
			end
		end
	end)

	local M = { S = S }
	function M.SetActive(v)
		S.enabled = v and true or false
		if S.enabled then S.nextCast = 0 else S.reeling = false end
	end
	function M.IsActive() return S.enabled end
	function M.Info()
		return "Status: " .. (not S.enabled and "Idle" or S.reeling and "Reeling" or "Menunggu gigitan")
	end
	function M.Kill()
		alive = false
		S.enabled = false
		S.reeling = false
	end
	return M
end

