		Text = "Tonton", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = K.tx, AutoButtonColor = true,
	}, row)
	round(specB, 9)
	local tpB = new("TextButton", {
		Size = UDim2.fromOffset(52, 32), Position = UDim2.new(1, -60, 0.5, -16), BackgroundColor3 = K.card2,
		Text = "TP", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = K.gold, AutoButtonColor = true,
	}, row)
	round(tpB, 9)
	C(specB.MouseButton1Click, function()
		if State.spectateEnabled and State.spectateTarget == plr then disableSpectate() else enableSpectate(plr) end
	end)
	C(tpB.MouseButton1Click, function() tpToPlayer(plr) end)
	rows[plr] = { row = row, sub = sub, specB = specB }
	applyFilter()
end

local function removeRow(plr)
	local r = rows[plr]
	if r then
		r.row:Destroy()
		rows[plr] = nil
	end
	if State.spectateTarget == plr then disableSpectate() end
end

