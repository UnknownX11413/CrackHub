local function switchRow(parent, text, get, set, order)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = K.card, BorderSizePixel = 0, LayoutOrder = order or 0 }, parent)
	round(row, 12)
	new("TextLabel", {
		Size = UDim2.new(1, -70, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
		Text = text, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = K.tx,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local sw = new("TextButton", {
		Size = UDim2.fromOffset(46, 26), Position = UDim2.new(1, -56, 0.5, -13),
		BackgroundColor3 = K.off, Text = "", AutoButtonColor = false,
	}, row)
	round(sw, 13)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(2, 2),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, sw)
	round(knob, 11)
	local last
	local function render()
		local v = get() and true or false
		if v == last then return end
		last = v
		tween(sw, 0.2, { BackgroundColor3 = v and K.ok or K.off })
		tween(knob, 0.2, { Position = v and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2) })
	end
	C(sw.MouseButton1Click, function() set(not get()) render() end)
	render()
	table.insert(refreshers, render)
end

local function stepper(parent, text, get, set, minv, maxv, stp, order)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = K.card, BorderSizePixel = 0, LayoutOrder = order or 0 }, parent)
	round(row, 12)
	new("TextLabel", {
		Size = UDim2.new(1, -170, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
		Text = text, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = K.tx,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local val = new("TextLabel", {
		Size = UDim2.fromOffset(64, 28), Position = UDim2.new(1, -106, 0.5, -14), BackgroundTransparency = 1,
		Text = "", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = K.gold,
	}, row)
	local function render() val.Text = tostring(get()) end
	local function btn(txt, x, dir)
		local b = new("TextButton", {
			Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, x, 0.5, -14),
			BackgroundColor3 = K.card2, Text = txt, Font = Enum.Font.GothamBold, TextSize = 16,
			TextColor3 = K.tx, AutoButtonColor = true,
		}, row)
		round(b, 8)
		C(b.MouseButton1Click, function()
			set(math.clamp(get() + dir * stp, minv, maxv))
			render()
		end)
	end
	btn("−", -138, -1)
	btn("+", -38, 1)
	render()
end

local function actionBtn(parent, text, cb, order)
