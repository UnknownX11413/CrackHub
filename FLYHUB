-- ---------- RESIZE (pojok kanan bawah) ----------
local grip = new("TextButton", {
	Size = UDim2.fromOffset(34, 34), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -2, 1, -2),
	BackgroundTransparency = 1, Text = "", ZIndex = 20, AutoButtonColor = false,
}, win)
new("Frame", {
	Size = UDim2.fromOffset(11, 2), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -8, 1, -8),
	BackgroundColor3 = K.tx2, BorderSizePixel = 0, ZIndex = 21,
}, grip)
new("Frame", {
	Size = UDim2.fromOffset(2, 11), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -8, 1, -8),
	BackgroundColor3 = K.tx2, BorderSizePixel = 0, ZIndex = 21,
}, grip)
do
	local MINW, MINH = 280, 380
	local rs, rStart, rSize, rPos
	C(grip.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			rs, rStart, rSize, rPos = true, i.Position, win.Size, win.Position
		end
	end)
	C(UIS.InputChanged, function(i)
		if rs and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local sc = scale.Scale
			local d = (i.Position - rStart) / sc
			local vs = workspace.CurrentCamera.ViewportSize
			local maxW = math.max(MINW, math.min(560, vs.X / sc - 16))
			local maxH = math.max(MINH, math.min(820, vs.Y / sc - 16))
			local nw = math.clamp(rSize.X.Offset + d.X, MINW, maxW)
			local nh = math.clamp(rSize.Y.Offset + d.Y, MINH, maxH)
			win.Size = UDim2.fromOffset(nw, nh)
			win.Position = UDim2.new(rPos.X.Scale, rPos.X.Offset + (nw - rSize.X.Offset) / 2,
				rPos.Y.Scale, rPos.Y.Offset + (nh - rSize.Y.Offset) / 2)
		end
	end)
	C(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then rs = false end
	end)
end

-- ---------- KEYBIND ----------
C(UIS.InputBegan, function(input, gpe)
	if gpe then return end
	local k = input.KeyCode
	if k == Enum.KeyCode.F then setFly(not State.flyEnabled)
	elseif k == Enum.KeyCode.P then toggleSpectate()
	elseif k == Enum.KeyCode.Q then tpMouse()
	elseif k == Enum.KeyCode.R then returnPos()
	end
end)

