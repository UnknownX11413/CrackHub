--====================================================================
-- HELPERS
--====================================================================
local function getChar() return lp.Character end
local function getHRP() local c = getChar() return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum() local c = getChar() return c and c:FindFirstChildOfClass("Humanoid") end

local function setNoCollide(enable)
	local char = getChar()
	if not char then return end
	if enable then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") and p.CanCollide then
				table.insert(State.noCollideData, p)
				p.CanCollide = false
			end
		end
	else
		for _, p in ipairs(State.noCollideData) do
			pcall(function() p.CanCollide = true end)
		end
		State.noCollideData = {}
	end
end

local function streamBypass(pos, radius)
	if workspace.StreamingEnabled then
		pcall(function()
			workspace.StreamingMinRadius = radius
			workspace.StreamingTargetRadius = radius * 2
		end)
	end
	for x = -1, 1 do
		for z = -1, 1 do
			pcall(function()
				workspace:RequestStreamAroundAsync(pos + Vector3.new(x, 0, z) * radius * 0.5, 5)
			end)
		end
	end
end

--====================================================================
-- FLY (avatar selalu tegak, kecepatan di-lerp supaya halus)
--====================================================================
local ACCEL, DECEL = 12, 16

local function cleanFlyMotors()
	local hrp = getHRP()
	if hrp then
		local bv = hrp:FindFirstChild("__FlyBV"); if bv then bv:Destroy() end
		local bg = hrp:FindFirstChild("__FlyBG"); if bg then bg:Destroy() end
	end
end

local function enableFly()
	cleanFlyMotors()
	local hrp, hum = getHRP(), getHum()
	if not hrp or not hum then return end

	hum.PlatformStand = true
	hum.JumpPower = 0
	hum.AutoRotate = false
	State.noCollideData = {}
	setNoCollide(true)

	local bv = Instance.new("BodyVelocity")
	bv.Name = "__FlyBV"
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.Velocity = Vector3.new(0, 0, 0)
	bv.Parent = hrp

	local bg = Instance.new("BodyGyro")
	bg.Name = "__FlyBG"
	bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	bg.P = 5e4
	bg.D = 500
	bg.CFrame = hrp.CFrame
	bg.Parent = hrp

	State.vel = Vector3.new(0, 0, 0)
	local ncTimer = 0

	if State.flyConn then State.flyConn:Disconnect() end
	State.flyConn = RunService.Heartbeat:Connect(function(dt)
		if not State.flyEnabled then return end
		local hrp2, hum2 = getHRP(), getHum()
		if not hrp2 then return end

		local camCF = cam.CFrame
		local look, right = camCF.LookVector, camCF.RightVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		local flatUnit = flatLook.Magnitude > 0.01 and flatLook.Unit or Vector3.new(0, 0, -1)
		local flatRight = Vector3.new(right.X, 0, right.Z)
		flatRight = flatRight.Magnitude > 0.01 and flatRight.Unit or Vector3.new(1, 0, 0)

		local rawDir = Vector3.new(0, 0, 0)

		-- joystick / WASD lewat MoveDirection (HP & PC), diterjemahkan ke arah kamera penuh
		local md = hum2 and hum2.MoveDirection or Vector3.new()
		if md.Magnitude > 0.05 then
			rawDir = rawDir + look * md:Dot(flatUnit) + right * md:Dot(flatRight)
		else
			if UIS:IsKeyDown(Enum.KeyCode.W) then rawDir = rawDir + look end
			if UIS:IsKeyDown(Enum.KeyCode.S) then rawDir = rawDir - look end
			if UIS:IsKeyDown(Enum.KeyCode.A) then rawDir = rawDir - right end
			if UIS:IsKeyDown(Enum.KeyCode.D) then rawDir = rawDir + right end
		end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then rawDir = rawDir + Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then rawDir = rawDir - Vector3.yAxis end

		local dir = rawDir.Magnitude > 1 and rawDir.Unit or rawDir
		local targetVel = dir * State.flySpeed
		local alpha = dir.Magnitude > 0 and math.min(1, dt * ACCEL) or math.min(1, dt * DECEL)
		State.vel = State.vel:Lerp(targetVel, alpha)
		bv.Velocity = State.vel

		-- avatar tegak: hanya ikut yaw kamera
		bg.CFrame = CFrame.fromMatrix(hrp2.Position, flatUnit:Cross(Vector3.yAxis).Unit * -1, Vector3.yAxis, -flatUnit)

		ncTimer = ncTimer + dt
		if ncTimer >= 0.5 then
			ncTimer = 0
			setNoCollide(true)
		end
	end)
end

local function disableFly()
	if State.flyConn then State.flyConn:Disconnect(); State.flyConn = nil end
	cleanFlyMotors()
	State.vel = Vector3.new(0, 0, 0)
	local hum = getHum()
	if hum then
		hum.PlatformStand = false
		hum.JumpPower = 50
		hum.AutoRotate = true
	end
	setNoCollide(false)
end

local function setFly(v)
	v = v and true or false
	if v == State.flyEnabled then return end
	State.flyEnabled = v
	if v then enableFly() else disableFly() end
end

--====================================================================
-- SPECTATE
--====================================================================
local function disableSpectate()
	State.spectateEnabled = false
	State.spectateTarget = nil
	if State.specConn then State.specConn:Disconnect(); State.specConn = nil end
	cam.CameraType = Enum.CameraType.Custom
end

local function enableSpectate(target)
	if State.specConn then State.specConn:Disconnect(); State.specConn = nil end
	State.spectateEnabled = true
	State.spectateTarget = target
	cam.CameraType = Enum.CameraType.Scriptable
	State.specConn = RunService.Heartbeat:Connect(function()
		if not State.spectateEnabled then return end
		if not (target and target.Parent) then disableSpectate() return end
		local tChar = target.Character
		if not tChar then return end
		local tHRP = tChar:FindFirstChild("HumanoidRootPart")
		if not tHRP then return end
		local offset = CFrame.Angles(math.rad(-12), 0, 0) * CFrame.new(0, 2, -10)
		cam.CFrame = tHRP.CFrame * offset
		streamBypass(tHRP.Position, State.spectateRadius)
	end)
end

local function getTargetList()
	local t = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then table.insert(t, p) end
	end
	table.sort(t, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
	return t
end

local function stepSpectate(dir)
	local list = getTargetList()
	if #list == 0 then return end
	local idx = table.find(list, State.spectateTarget) or 0
	idx = ((idx - 1 + dir) % #list) + 1
	enableSpectate(list[idx])
end

local function toggleSpectate()
	if State.spectateEnabled then
		disableSpectate()
	else
		local list = getTargetList()
		if list[1] then enableSpectate(list[1]) end
	end
end

--====================================================================
-- TELEPORT
--====================================================================
local function savePos()
	local hrp = getHRP()
	if hrp then State.savedPos = hrp.CFrame end
end
local function returnPos()
	if State.savedPos then
		local hrp = getHRP()
		if hrp then hrp.CFrame = State.savedPos end
	end
end
local function tpMouse()
	local m = UIS:GetMouseLocation()
	local ray = cam:ViewportPointToRay(m.X, m.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { getChar() }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
	if hit then
		local hrp = getHRP()
		if hrp then hrp.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3, 0)) end
	end
end
local function tpToPlayer(plr)
	local tc = plr.Character
	local th = tc and tc:FindFirstChild("HumanoidRootPart")
	local hrp = getHRP()
	if th and hrp then
		hrp.CFrame = th.CFrame * CFrame.new(0, 0, 4)
	end
end

