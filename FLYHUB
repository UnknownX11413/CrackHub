task.spawn(function()
	while gui.Parent do
		-- fly tab
		flyInfo.Text = ("Fly: %s | Kecepatan: %d"):format(State.flyEnabled and "ON" or "OFF", State.flySpeed)
		-- pemain tab
		local hrp = getHRP()
		if State.spectateEnabled and State.spectateTarget then
			specInfo.Text = "Menonton: " .. State.spectateTarget.DisplayName .. " (@" .. State.spectateTarget.Name .. ")"
			specInfo.TextColor3 = K.ok
		else
			specInfo.Text = "Tidak sedang menonton. Pilih pemain di bawah."
			specInfo.TextColor3 = K.tx2
		end
		local count = 0
		for plr, r in pairs(rows) do
			count += 1
			local th = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			local dist = (hrp and th) and math.floor((hrp.Position - th.Position).Magnitude) or nil
			r.sub.Text = "@" .. plr.Name .. (dist and (" · " .. dist .. "m") or " · -")
			local watching = State.spectateEnabled and State.spectateTarget == plr
			r.specB.Text = watching and "Stop" or "Tonton"
			r.specB.BackgroundColor3 = watching and K.ok or K.card2
		end
		listHeader.Text = "DAFTAR PEMAIN (" .. count .. ")"
		-- teleport tab
		if State.savedPos then
			local p = State.savedPos.Position
			tpInfo.Text = ("Posisi tersimpan: %d, %d, %d"):format(p.X, p.Y, p.Z)
		else
			tpInfo.Text = "Belum ada posisi tersimpan."
		end
		-- switch & footer
		for _, f in ipairs(refreshers) do pcall(f) end
		if cur == 1 then
			go.Text = State.flyEnabled and "Matikan Fly" or "Nyalakan Fly"
			go.BackgroundColor3 = State.flyEnabled and K.bad or K.ok
		elseif cur == 2 then
			go.Text = State.spectateEnabled and "Berhenti Spectate" or "Mulai Spectate"
			go.BackgroundColor3 = State.spectateEnabled and K.bad or K.ok
		else
			go.Text = "Kembali ke Posisi Tersimpan"
			go.BackgroundColor3 = State.savedPos and K.ok or K.off
		end
		task.wait(0.3)
	end
end)

